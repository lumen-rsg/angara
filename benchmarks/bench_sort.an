// Benchmark: Bubble sort (in-place array mutation)
attach io;

export func main() -> i64 {
    let n = 20000;

    // Build a reverse-sorted list
    let arr as list<i64> = [];
    for (let i = n - 1; i >= 0; i = i - 1) {
        arr.push(i);
    }

    // Bubble sort
    let swapped = true;
    while (swapped) {
        swapped = false;
        for (let i = 1; i < len(arr); i = i + 1) {
            if (arr[i - 1] > arr[i]) {
                let tmp = arr[i - 1];
                arr[i - 1] = arr[i];
                arr[i] = tmp;
                swapped = true;
            }
        }
    }

    // Verify sorted
    let sorted = true;
    for (let i = 1; i < len(arr); i = i + 1) {
        if (arr[i - 1] > arr[i]) {
            sorted = false;
        }
    }

    io.println(1, "Sorted: " + string(sorted));
    io.println(1, "First: " + string(arr[0]) + " Last: " + string(arr[n - 1]));
    return 0;
}
