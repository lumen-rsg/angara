@startuml uml_package
top to bottom direction
skinparam packageStyle rectangle
skinparam monochrome false
skinparam nodesep 10
skinparam ranksep 60
skinparam wrapWidth 100

title Диаграмма пакетов:\nСтруктура компилятора Angara (angc/)

' ──────────────────────────────
' Frontend — Lexer
' ──────────────────────────────
package "frontend/lexer/" #DDDDFF {
    [Lexer]
    [Token]
}

' ──────────────────────────────
' Frontend — Parser
' ──────────────────────────────
package "frontend/parser/" #D8D8FF {
    [Parser]
    [Expression Nodes\n(12 типов)]
    [Statement Nodes\n(11 типов)]
    [Declaration Nodes\n(6 типов)]
}

' ──────────────────────────────
' Analyzer
' ──────────────────────────────
package "analyzer/" #DDFFDD {

    package "analyzer/table/" {
        [SymbolTable]
    }

    package "analyzer/type_checker/" {
        [TypeChecker]
        [Expression Checks\n(17+ файлов)]
        [Statement Checks\n(17+ файлов)]
    }

    package "analyzer/printer/" {
        [ASTPrinter]
    }

}

' ──────────────────────────────
' Backend — LLVM
' ──────────────────────────────
package "backend/llvm/" #FFDDDD {
    [LLVMBackend]
    [RuntimeBuilder]
    [TopLevel]
    [ExprCodegen]
    [StmtCodegen]
    [Runtime Modules\n(7 модулей)]
}

' ──────────────────────────────
' Backend — Driver
' ──────────────────────────────
package "backend/driver/" #FFE0E0 {
    [CompilerDriver]
}

' ──────────────────────────────
' Backend — Build System
' ──────────────────────────────
package "backend/build_system/" #FFD5D5 {
    [BuildSystem]
    [ConfigParser]
    [ProjectInitializer]
}

' ──────────────────────────────
' Includes (заголовки)
' ──────────────────────────────
package "includes/" #EEEEEE {
    [Core Headers\n(Expr, Stmt, Token, Type)]
    [Component Headers\n(Lexer, Parser, TypeChecker,\nSymbolTable, LLVMBackend)]
    [Driver & Build Headers\n(CompilerDriver, BuildSystem,\nRuntimeBuilder)]
    [Utility Headers\n(ErrorHandler, AngaraABI,\nFormatter, Platform, ...)]
}

' ──────────────────────────────
' Shared
' ──────────────────────────────
package "shared/" #FFFFDD {
    [ErrorHandler]
    [StringUtils]
}

' ──────────────────────────────
' Entry point
' ──────────────────────────────
package "src/" #FFEEDD {
    [main.cpp]
    [EasterEgg.cpp]
}

@enduml