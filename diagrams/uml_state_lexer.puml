@startuml lexer_state_machine
skinparam monochrome false
skinparam linetype ortho
skinparam nodesep 20
skinparam ranksep 50

title Диаграмма конечного автомата:\nЛексический анализатор (Lexer)

' ──────────────────────────────
' Начальное состояние
' ──────────────────────────────
[*] --> ScanChar

state ScanChar as "ScanChar\n(Чтение следующего символа)"

' ──────────────────────────────
' Идентификаторы и ключевые слова
' ──────────────────────────────
ScanChar --> IsAlpha : буква / _
IsAlpha --> Identifier : accumulate()
Identifier --> ScanChar : не буква/цифра\n→ addToken(KEYWORD / IDENT)

' ──────────────────────────────
' Числа (целые и вещественные)
' ──────────────────────────────
ScanChar --> IsDigit : цифра
IsDigit --> Number : accumulate()
Number --> FloatPart : точка
Number --> ScanChar : не цифра/точка\n→ addToken(NUMBER)
FloatPart --> ScanChar : не цифра\n→ addToken(NUMBER)

' ──────────────────────────────
' Строковые литералы
' ──────────────────────────────
ScanChar --> IsQuote : " или """
IsQuote --> String : открывающая кавычка
String --> EscapeSequence : обратный слеш
EscapeSequence --> String : обработать\n\\n \\t \\\\ \\"
String --> ScanChar : закрывающая кавычка\n→ addToken(STRING)

' ──────────────────────────────
' Операторы (одиночные и составные)
' ──────────────────────────────
ScanChar --> IsOperator : + - * / = < >\n! & | % ^ ~ . :
IsOperator --> Operator1 : одиночный символ
Operator1 --> Operator2 : возможен +=, ==, !=,\n<=, >=, &&, ||, ++, --, ::
Operator1 --> ScanChar : нет продолжения\n→ addToken(OP)
Operator2 --> ScanChar : addToken(COMPOUND_OP)

' ──────────────────────────────
' Комментарии и символ /
' ──────────────────────────────
ScanChar --> IsSlash : /
IsSlash --> LineComment : /
IsSlash --> BlockComment : *
IsSlash --> ScanChar : addToken(SLASH)
LineComment --> ScanChar : newline → пропустить
BlockComment --> ScanChar : */ → пропустить

' ──────────────────────────────
' Пробельные символы
' ──────────────────────────────
ScanChar --> IsWhitespace : пробел / таб / newline
IsWhitespace --> ScanChar : пропустить\n(newline → line++)

' ──────────────────────────────
' Конец файла
' ──────────────────────────────
ScanChar --> IsEOF : конец файла

' ──────────────────────────────
' Поток токенов
' ──────────────────────────────
IsEOF --> TokenStream : addToken(EOF)

state "Token Stream\n(Поток токенов)" as TokenStream {
    [*] --> Collect
    Collect --> Collect : addToken(type, literal)
    Collect --> [*] : EOF
}

TokenStream --> [*] : return vector<Token>

@enduml