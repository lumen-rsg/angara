// Interface file for the 'jwt' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach jwt;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/crypto/ alongside jwt.c.

// Create a JWT with the given payload and signing options.
// Returns a record with the token string.
export func create(payload as record, options as record) -> record;

// Verify a JWT token string with the given secret key.
// Returns a record with verification result and decoded payload.
export func verify(token as string, secret as string) -> record;

// Decode a JWT token string without verification.
// Returns a record with header and payload.
export func decode(token as string) -> record;
