// Interface file for the 'config' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach config;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/data/ alongside config.c.

// Parse an INI-format configuration string. Returns a nested record.
export func parse_ini(content as string) -> record;

// Serialize a record to an INI-format string.
export func stringify_ini(data as record) -> string;

// Parse a TOML-format configuration string. Returns a nested record.
export func parse_toml(content as string) -> record;

// Parse a dotenv (.env) formatted string. Returns a record of key-value pairs.
export func parse_dotenv(content as string) -> record;

// Serialize a record to a dotenv (.env) formatted string.
export func stringify_dotenv(data as record) -> string;
