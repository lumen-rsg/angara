// Interface file for the 'mysql' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach mysql;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/data/ alongside mysql.c.

// Connect to a MySQL/MariaDB database.
// Returns a connection handle (MyConn class instance).
export func connect(host as string, user as string, password as string, database as string, port as i64) -> any;
