// Interface file for the 'yaml' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach yaml;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/data/ alongside yaml.c.

// Parse a YAML string into an Angara value.
export func parse(content as string) -> any;

// Serialize an Angara value to a YAML string.
export func stringify(value as any) -> string;
