// Interface file for the 'log' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach log;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/io/ alongside log.c.

// Set the minimum log level ("debug", "info", "warn", "error").
export func set_level(level as string) -> nil;

// Log a debug message.
export func debug(message as string) -> nil;

// Log an info message.
export func info(message as string) -> nil;

// Log a warning message.
export func warn(message as string) -> nil;

// Log an error message.
export func error(message as string) -> nil;
