// Interface file for the 'bigint' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach bigint;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/math/ alongside bigint.c.

// Create a BigInt from an i64 value. Returns a BigInt class instance.
export func from_i64(value as i64) -> any;

// Create a BigInt from a decimal string representation.
// Returns a BigInt class instance.
export func from_string(value as string) -> any;
