// Interface file for the 'env' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach env;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/system/ alongside env.c.

// Get an environment variable. Returns nil if not set.
export func get(name as string) -> string;

// Set an environment variable.
export func set(name as string, value as string) -> nil;

// Unset (remove) an environment variable.
export func unset(name as string) -> nil;

// Get all environment variables as a record.
export func all() -> record;

// Get the command-line arguments as a list of strings.
export func args() -> list<string>;

// Get the current process ID.
export func pid() -> i64;

// Get the parent process ID.
export func ppid() -> i64;

// Get the current working directory.
export func cwd() -> string;

// Change the current working directory.
export func chdir(path as string) -> nil;

// Get the system hostname.
export func hostname() -> string;

// Get the current user name.
export func user() -> string;

// Get the current user's home directory.
export func home() -> string;

// Get the current user's shell path.
export func shell() -> string;
