// Interface file for the 'calltest' native module.
// Documents the type signatures of all exported functions.
//
// Usage: attach calltest;
//
// Note: This is a documentation interface file. When compiler support
// for interface-based type-checking is added (L30), this file will be
// moved to modules/testing/ alongside calltest.c.

// Invoke a callable with an argument list. Returns the result.
export func invoke(fn as any, args as any, count as i64) -> any;

// Invoke a callable with no arguments. Returns the result.
export func invoke0(fn as any) -> any;

// Invoke a callable with one argument. Returns the result.
export func invoke1(fn as any, arg as any) -> any;
