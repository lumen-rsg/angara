{
  "name": "angara",
  "displayName": "Angara Language Support",
  "description": "Syntax highlighting, diagnostics, completion, hover, and go-to-definition for the Angara programming language",
  "version": "0.1.0",
  "publisher": "angara-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:angara"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "angara",
        "aliases": [
          "Angara",
          "angara"
        ],
        "extensions": [
          ".an"
        ],
        "scopeName": "source.angara",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.angara",
        "path": "./syntaxes/angara.tmLanguage.json",
        "language": "angara"
      }
    ],
    "configuration": {
      "title": "Angara",
      "properties": {
        "angara.languageServer.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Absolute path to the angc binary. If not set, angc must be on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.20.0"
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "npm run compile && vsce package"
  }
}
