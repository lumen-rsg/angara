{
  "scopeName": "source.angara",
  "name": "Angara",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.angara",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.angara",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.angara",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.angara",
              "match": "\\\\[\\\\\"nrtbfva0-7]|\\\\x[0-9a-fA-F]{2}"
            }
          ]
        },
        {
          "name": "string.quoted.double.angara",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.angara",
              "match": "\\\\[\\\\\"nrtbfva0-7]|\\\\x[0-9a-fA-F]{2}"
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.angara",
          "match": "@\\w+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.angara",
          "match": "\\b(if|orif|else|for|while|in|match|case|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.angara",
          "match": "\\b(let|const|func|class|data|enum|trait|contract|export|foreign|intrinsic|union)\\b"
        },
        {
          "name": "storage.modifier.angara",
          "match": "\\b(static|private|public|inherits|uses|signs)\\b"
        },
        {
          "name": "keyword.control.exception.angara",
          "match": "\\b(try|catch|throw)\\b"
        },
        {
          "name": "keyword.control.import.angara",
          "match": "\\b(attach|from|as)\\b"
        },
        {
          "name": "variable.language.angara",
          "match": "\\b(this|super)\\b"
        },
        {
          "name": "keyword.other.angara",
          "match": "\\b(is|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.angara",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|uint|f32|f64|string|int|float|bool|void|any|list|map|record|function|Thread|Mutex|Exception|c_ptr)\\b"
        },
        {
          "name": "entity.name.type.angara",
          "match": "\\b[A-Z]\\w*\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.angara",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.angara",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.angara",
          "match": "\\bnil\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.angara",
          "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.angara",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.angara",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.angara",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.angara",
          "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\?\\.|->|\\.\\.\\.|\\.\\.|::)"
        },
        {
          "name": "keyword.operator.angara",
          "match": "[+\\-*/%<>=!&\\|^~?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.angara",
          "match": ";"
        },
        {
          "name": "punctuation.separator.angara",
          "match": "[,:]"
        },
        {
          "name": "punctuation.section.block.angara",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.angara",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.angara",
          "match": "[\\[\\]]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.angara",
          "match": "\\b[_a-z]\\w*\\b"
        }
      ]
    }
  }
}
