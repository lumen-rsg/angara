// ============================================================================
// ankernel — A bare-metal Angara kernel for ARM64 (QEMU virt)
//
// Uses only intrinsics, integer arithmetic, and bitwise operators.
// No string operations, no libc — pure freestanding.
// ============================================================================

// --- Intrinsic declarations (compiler-provided, no libc needed) ---
intrinsic func peek32(addr as i64) -> i64;
intrinsic func poke32(addr as i64, val as i64) -> nil;
intrinsic func halt() -> nil;

// --- The boot banner as a no-heap .rodata byte array (F3) ---
// A byte-string literal (b"...") assigned to a [u8; N] const lowers to a
// read-only global — no heap allocation, no string runtime.
const MSG as [u8; 20] = b"Hello from Angara!\r\n";

// --- Print a single character to PL011 UART (QEMU virt: 0x0900_0000) ---
func uart_putc(c as i64) -> nil {
    // UART_FR is at offset 0x18 = 0x09000018
    // Bit 5 (0x20) = TX FIFO full
    while ((peek32(0x09000018) & 0x20) != 0) {}
    // UART_DR is at base = 0x09000000
    poke32(0x09000000, c);
}

// --- Kernel entry point ---
func main() -> nil {
    // Print the banner byte by byte from the .rodata array.
    let n as i64 = len(MSG);
    for (let i = 0; i < n; i = i + 1) {
        uart_putc(MSG[i] as i64);
    }

    // Halt the CPU
    halt();
}
