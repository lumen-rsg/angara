//
// Angara Standard Collections Library
//
// C#-styled collection operations inspired by System.Linq & System.Collections.Generic.
// All functions work on the built-in list<any> type.
//
// Convention:
//   - Functions that return new lists do NOT mutate the input (readonly-safe).
//   - Mutation (Add/Remove) should be done directly via .push() on local list variables.
//   - Higher-order functions accept closures (lambdas or named function refs) as `any`.
//     Since calling `any` is a dynamic operation, those functions use @unsafe blocks.
//

// ============================================================
// CREATION  (C# Enumerable equivalents)
// ============================================================

/// Create an empty list.
export func Empty() -> list<any> {
    return [];
}

/// Generate a range of integers (C# Enumerable.Range).
export func Range(start as i64, count as i64) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < count) {
        result.push(start + i);
        i = i + 1;
    }
    return result;
}

/// Repeat a value n times (C# Enumerable.Repeat).
export func Repeat(value as any, count as i64) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < count) {
        result.push(value);
        i = i + 1;
    }
    return result;
}

// ============================================================
// QUERY OPERATORS  (C# Enumerable — non-mutating)
// ============================================================

/// Return the first element, or nil if empty (C# Enumerable.First).
export func First(items as list<any>) -> any {
    if (len(items) > 0) {
        return items[0];
    }
    return nil;
}

/// Return the last element, or nil if empty (C# Enumerable.Last).
export func Last(items as list<any>) -> any {
    if (len(items) > 0) {
        return items[len(items) - 1];
    }
    return nil;
}

/// Get element at index, or nil if out of range (C# Enumerable.ElementAtOrDefault).
export func ElementAt(items as list<any>, index as i64) -> any {
    if (index >= 0 && index < len(items)) {
        return items[index];
    }
    return nil;
}

/// Check if the list contains a value (C# Enumerable.Contains).
export func Contains(items as list<any>, value as any) -> bool {
    let i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Find first index of value, or -1 (C# List.IndexOf).
export func IndexOf(items as list<any>, value as any) -> i64 {
    let i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Find last index of value, or -1 (C# List.LastIndexOf).
export func LastIndexOf(items as list<any>, value as any) -> i64 {
    let i = len(items) - 1;
    while (i >= 0) {
        if (items[i] == value) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

/// Get the total number of elements (C# List<T>.Count / Enumerable.Count).
export func Count(items as list<any>) -> i64 {
    return len(items);
}

// ============================================================
// TRANSFORMS  (non-mutating — return new lists)
// ============================================================

/// Return a specified number of elements from the start (C# Enumerable.Take).
export func Take(items as list<any>, n as i64) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < n && i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    return result;
}

/// Bypass a specified number of elements, return the rest (C# Enumerable.Skip).
export func Skip(items as list<any>, n as i64) -> list<any> {
    let result as list<any> = [];
    let i = n;
    while (i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    return result;
}

/// Take elements from start..end (Python-style slicing).
export func Slice(items as list<any>, start as i64, end as i64) -> list<any> {
    let result as list<any> = [];
    let i = start;
    while (i < end && i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    return result;
}

/// Reverse the order of elements (C# Enumerable.Reverse).
export func Reverse(items as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = len(items) - 1;
    while (i >= 0) {
        result.push(items[i]);
        i = i - 1;
    }
    return result;
}

/// Concatenate two lists (C# Enumerable.Concat).
export func Concat(a as list<any>, b as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < len(a)) {
        result.push(a[i]);
        i = i + 1;
    }
    i = 0;
    while (i < len(b)) {
        result.push(b[i]);
        i = i + 1;
    }
    return result;
}

/// Return distinct/unique elements (C# Enumerable.Distinct).
export func Distinct(items as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < len(items)) {
        let item = items[i];
        let found = false;
        let j = 0;
        while (j < len(result)) {
            if (result[j] == item) {
                found = true;
            }
            j = j + 1;
        }
        if (!found) {
            result.push(item);
        }
        i = i + 1;
    }
    return result;
}

// ============================================================
// HIGHER-ORDER FUNCTIONS  (C# LINQ-style with lambdas)
// Functions that call `any`-typed closures require @unsafe blocks.
// ============================================================

/// Map each element through a transform function (C# Enumerable.Select).
export func Select(items as list<any>, transform as any) -> list<any> {
    @unsafe {
        let result as list<any> = [];
        let i = 0;
        while (i < len(items)) {
            result.push(transform(items[i]));
            i = i + 1;
        }
        return result;
    }
    return [];
}

/// Filter elements that satisfy a predicate (C# Enumerable.Where).
export func Where(items as list<any>, predicate as any) -> list<any> {
    @unsafe {
        let result as list<any> = [];
        let i = 0;
        while (i < len(items)) {
            if (predicate(items[i])) {
                result.push(items[i]);
            }
            i = i + 1;
        }
        return result;
    }
    return [];
}

/// Execute an action for each element (C# List.ForEach).
export func ForEach(items as list<any>, action as any) -> any {
    @unsafe {
        let i = 0;
        while (i < len(items)) {
            action(items[i]);
            i = i + 1;
        }
    }
    return nil;
}

/// Reduce with an initial seed value (C# Enumerable.Aggregate).
export func Aggregate(items as list<any>, seed as any, accumulator as any) -> any {
    @unsafe {
        let result = seed;
        let i = 0;
        while (i < len(items)) {
            result = accumulator(result, items[i]);
            i = i + 1;
        }
        return result;
    }
    return nil;
}

/// Check if any element satisfies the predicate (C# Enumerable.Any with predicate).
export func AnyMatch(items as list<any>, predicate as any) -> bool {
    @unsafe {
        let i = 0;
        while (i < len(items)) {
            if (predicate(items[i])) {
                return true;
            }
            i = i + 1;
        }
    }
    return false;
}

/// Check if all elements satisfy the predicate (C# Enumerable.All).
export func All(items as list<any>, predicate as any) -> bool {
    @unsafe {
        let i = 0;
        while (i < len(items)) {
            let ok = predicate(items[i]);
            if (ok) {
                // element passes
            } else {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

/// Count elements that satisfy a predicate (C# Enumerable.Count with predicate).
export func CountMatch(items as list<any>, predicate as any) -> i64 {
    @unsafe {
        let count = 0;
        let i = 0;
        while (i < len(items)) {
            if (predicate(items[i])) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }
    return 0;
}

/// Find first element matching predicate, or nil (C# Enumerable.FirstOrDefault).
export func FirstMatch(items as list<any>, predicate as any) -> any {
    @unsafe {
        let i = 0;
        while (i < len(items)) {
            if (predicate(items[i])) {
                return items[i];
            }
            i = i + 1;
        }
    }
    return nil;
}

/// Find last element matching predicate, or nil (C# Enumerable.LastOrDefault).
export func LastMatch(items as list<any>, predicate as any) -> any {
    @unsafe {
        let i = len(items) - 1;
        while (i >= 0) {
            if (predicate(items[i])) {
                return items[i];
            }
            i = i - 1;
        }
    }
    return nil;
}

/// Sort elements using a comparator (C# OrderBy simplified).
/// comparator(a, b) returns true if a should come before b.
export func SortBy(items as list<any>, comparator as any) -> list<any> {
    // Copy the list
    let result as list<any> = [];
    let i = 0;
    while (i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    // Bubble sort using the comparator (dynamic call — needs @unsafe)
    @unsafe {
        let n = len(result);
        let outer = 0;
        while (outer < n - 1) {
            let inner = 0;
            while (inner < n - outer - 1) {
                if (comparator(result[inner + 1], result[inner])) {
                    let tmp = result[inner];
                    result[inner] = result[inner + 1];
                    result[inner + 1] = tmp;
                }
                inner = inner + 1;
            }
            outer = outer + 1;
        }
    }
    return result;
}

// ============================================================
// NUMERIC AGGREGATES
// ============================================================

/// Sum all numeric elements.
export func Sum(items as list<any>) -> i64 {
    @unsafe {
        let total = 0;
        let i = 0;
        while (i < len(items)) {
            total = total + items[i];
            i = i + 1;
        }
        return total;
    }
    return 0;
}

/// Find minimum numeric element, or 0 if empty.
export func Min(items as list<any>) -> i64 {
    if (len(items) == 0) { return 0; }
    @unsafe {
        let m = items[0];
        let i = 1;
        while (i < len(items)) {
            if (items[i] < m) {
                m = items[i];
            }
            i = i + 1;
        }
        return m;
    }
    return 0;
}

/// Find maximum numeric element, or 0 if empty.
export func Max(items as list<any>) -> i64 {
    if (len(items) == 0) { return 0; }
    @unsafe {
        let m = items[0];
        let i = 1;
        while (i < len(items)) {
            if (items[i] > m) {
                m = items[i];
            }
            i = i + 1;
        }
        return m;
    }
    return 0;
}

/// Compute average of numeric elements, or 0 if empty.
export func Average(items as list<any>) -> i64 {
    if (len(items) == 0) { return 0; }
    return Sum(items) / len(items);
}

// ============================================================
// SET OPERATIONS  (C# Enumerable set methods)
// ============================================================

/// Return elements in 'a' but not in 'b' (C# Enumerable.Except).
export func Except(a as list<any>, b as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < len(a)) {
        let item = a[i];
        if (!Contains(b, item)) {
            result.push(item);
        }
        i = i + 1;
    }
    return result;
}

/// Return elements common to both lists (C# Enumerable.Intersect).
export func Intersect(a as list<any>, b as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < len(a)) {
        let item = a[i];
        if (Contains(b, item) && !Contains(result, item)) {
            result.push(item);
        }
        i = i + 1;
    }
    return result;
}

/// Return distinct elements from both lists (C# Enumerable.Union).
export func Union(a as list<any>, b as list<any>) -> list<any> {
    return Distinct(Concat(a, b));
}

// ============================================================
// STRING / CONVERSION UTILITIES
// ============================================================

/// Join elements into a string with a separator (C# String.Join).
export func Join(items as list<any>, separator as string) -> string {
    let result = "";
    let i = 0;
    while (i < len(items)) {
        if (i > 0) {
            result = result + separator;
        }
        result = result + string(items[i]);
        i = i + 1;
    }
    return result;
}

// ============================================================
// COMPARISON / PREDICATE (no function params needed)
// ============================================================

/// Check if two lists have the same elements in order (C# Enumerable.SequenceEqual).
export func SequenceEqual(a as list<any>, b as list<any>) -> bool {
    if (len(a) != len(b)) {
        return false;
    }
    let i = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if the list is empty.
export func IsEmpty(items as list<any>) -> bool {
    return len(items) == 0;
}

/// Check if the list is not empty.
export func Any(items as list<any>) -> bool {
    return len(items) > 0;
}