//
// Angara Standard Collections Library
//
// Collection operations for list<any>.
// Uses Angara's dynamic runtime internally.
//

// --- Transformers ---

// Apply a function to every element, returning a new list.
export func map(transform as function(any) -> any, items as list<any>) -> list<any> {
    let result as list<any> = [];
    for (item in items) {
        result.push(transform(item));
    }
    return result;
}

// Keep only elements that satisfy a predicate.
export func filter(predicate as function(any) -> bool, items as list<any>) -> list<any> {
    let result as list<any> = [];
    for (item in items) {
        if (predicate(item)) {
            result.push(item);
        }
    }
    return result;
}

// Reduce a list to a single value.
export func reduce(items as list<any>, initial as any, accumulator as function(any, any) -> any) -> any {
    let acc = initial;
    for (item in items) {
        acc = accumulator(acc, item);
    }
    return acc;
}

// --- Search ---

// Find the first element matching a predicate, or nil.
export func find(predicate as function(any) -> bool, items as list<any>) -> any {
    for (item in items) {
        if (predicate(item)) {
            return item;
        }
    }
    return nil;
}

// True if any element satisfies the predicate.
export func any(items as list<any>, predicate as function(any) -> bool) -> bool {
    for (item in items) {
        if (predicate(item)) {
            return true;
        }
    }
    return false;
}

// True if all elements satisfy the predicate.
export func all(items as list<any>, predicate as function(any) -> bool) -> bool {
    for (item in items) {
        if (!predicate(item)) {
            return false;
        }
    }
    return true;
}

// True if the list contains the given value.
export func contains(items as list<any>, value as any) -> bool {
    for (item in items) {
        if (item == value) {
            return true;
        }
    }
    return false;
}

// Count elements satisfying a predicate.
export func count(predicate as function(any) -> bool, items as list<any>) -> i64 {
    let c = 0;
    for (item in items) {
        if (predicate(item)) {
            c = c + 1;
        }
    }
    return c;
}

// --- Ordering & Slicing ---

// Return a new list in reverse order.
export func reverse(items as list<any>) -> list<any> {
    let result as list<any> = [];
    let i = len(items) - 1;
    while (i >= 0) {
        result.push(items[i]);
        i = i - 1;
    }
    return result;
}

// Concatenate two lists.
export func concat(a as list<any>, b as list<any>) -> list<any> {
    let result = a;
    for (item in b) {
        result.push(item);
    }
    return result;
}

// Take the first n elements.
export func take(items as list<any>, n as i64) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < n && i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    return result;
}

// Skip the first n elements.
export func skip(items as list<any>, n as i64) -> list<any> {
    let result as list<any> = [];
    let i = n;
    while (i < len(items)) {
        result.push(items[i]);
        i = i + 1;
    }
    return result;
}

// --- Accessors ---

// First element, or nil.
export func first(items as list<any>) -> any {
    if (len(items) > 0) {
        return items[0];
    }
    return nil;
}

// Last element, or nil.
export func last(items as list<any>) -> any {
    if (len(items) > 0) {
        return items[len(items) - 1];
    }
    return nil;
}

// True if the list is empty.
export func is_empty(items as list<any>) -> bool {
    return len(items) == 0;
}

// --- Utilities ---

// Apply a function to each element (side-effects only).
export func for_each(items as list<any>, action as function(any) -> nil) {
    for (item in items) {
        action(item);
    }
}

// Join a list of strings with a separator.
export func join(items as list<any>, separator as string) -> string {
    let result = "";
    let i = 0;
    while (i < len(items)) {
        if (i > 0) {
            result = result + separator;
        }
        result = result + string(items[i]);
        i = i + 1;
    }
    return result;
}

// Split a string into a list of single characters.
export func chars(s as string) -> list<any> {
    let result as list<any> = [];
    let i = 0;
    while (i < len(s)) {
        result.push(s[i]);
        i = i + 1;
    }
    return result;
}