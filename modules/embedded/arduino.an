foreign func pinMode(pin as i64, mode as i64) -> nil;
foreign func digitalWrite(pin as i64, val as i64) -> nil;
foreign func digitalRead(pin as i64) -> i64;

foreign func analogRead(pin as i64) -> i64;
foreign func analogWrite(pin as i64, val as i64) -> nil;
foreign func analogReference(mode as i64) -> nil;

foreign func delay(ms as i64) -> nil;
foreign func delayMicroseconds(us as i64) -> nil;
foreign func millis() -> i64;
foreign func micros() -> i64;

foreign func pulseIn(pin as i64, value as i64) -> i64;
foreign func tone(pin as i64, frequency as i64) -> nil;
foreign func tone_duration(pin as i64, frequency as i64, duration as i64) -> nil;
foreign func noTone(pin as i64) -> nil;

foreign func serial_begin(baud as i64) -> nil;
foreign func serial_end() -> nil;
foreign func serial_available() -> i64;
foreign func serial_read() -> i64;
foreign func serial_print_i64(val as i64) -> nil;
foreign func serial_print_f64(val as f64) -> nil;
foreign func serial_println_i64(val as i64) -> nil;
foreign func serial_println_f64(val as f64) -> nil;
foreign func serial_flush() -> nil;

// Pin modes
let INPUT as i64 = 0;
let OUTPUT as i64 = 1;
let INPUT_PULLUP as i64 = 2;

// Digital levels
let HIGH as i64 = 1;
let LOW as i64 = 0;

// LED built-in pin (varies by board; 13 for Uno/Nano/Mega)
let LED_BUILTIN as i64 = 13;

// Analog reference modes
let DEFAULT as i64 = 0;
let INTERNAL as i64 = 1;
let EXTERNAL as i64 = 2;

// Blink an LED a specific number of times
func blink(pin as i64, count as i64, on_ms as i64, off_ms as i64) -> nil {
    for (let i as i64 = 0; i < count; i = i + 1) {
        digitalWrite(pin, HIGH);
        delay(on_ms);
        digitalWrite(pin, LOW);
        delay(off_ms);
    }
}

// Convenience: blink the built-in LED
func heartbeat(count as i64) -> nil {
    blink(LED_BUILTIN, count, 200, 200);
}