// imgui.an — Angara Dear ImGui Module Type Declarations
//
// Provides class-based OOP bindings for Dear ImGui via GLFW + OpenGL3.
//
// Usage:
//   attach imgui;
//   let ctx = imgui.Context("My App", 1280, 720);
//   ctx.style_colors_dark();
//   while (!ctx.window_should_close()) {
//       ctx.poll_events();
//       ctx.new_frame();
//       // ... ImGui widgets ...
//       ctx.render();
//       ctx.swap_buffers();
//   }
//   ctx.destroy();

// ═══════════════════════════════════════════════════════════════════
// Context — Main ImGui context wrapping GLFW window + OpenGL3 renderer
// ═══════════════════════════════════════════════════════════════════
//
// Constructor: imgui.Context(title: string, width?: i64, height?: i64) -> Context
//   Creates a GLFW window and initializes ImGui with OpenGL3 backend.
//
//   - title:  Window title (default: "Angara ImGui Window")
//   - width:  Window width in pixels (default: 1280)
//   - height: Window height in pixels (default: 720)
//
// ═══════════════════════════════════════════════════════════════════
// Lifecycle Methods
// ═══════════════════════════════════════════════════════════════════
//
// ctx.destroy() -> nil
//   Shuts down ImGui, destroys the GLFW window, and cleans up resources.
//
// ctx.new_frame() -> nil
//   Starts a new ImGui frame. Call before any widget calls.
//
// ctx.render() -> nil
//   Finalizes the ImGui frame and renders draw data. Call after all widgets.
//
// ctx.swap_buffers() -> nil
//   Swaps the OpenGL front/back buffers (displays the rendered frame).
//
// ctx.poll_events() -> nil
//   Polls for GLFW input events (mouse, keyboard, window resize).
//
// ctx.window_should_close() -> bool
//   Returns true if the window close button was pressed or glfwSetWindowShouldClose was called.
//
// ctx.get_display_size() -> record{width: f64, height: f64}
//   Returns the current framebuffer dimensions.
//
// ctx.get_fps() -> f64
//   Returns the current framerate (frames per second).
//
// ctx.set_clear_color(r: f64, g: f64, b: f64, a: f64) -> nil
//   Sets the background clear color (RGBA, each 0.0–1.0).
//
// ctx.set_window_title(title: string) -> nil
//   Changes the window title.
//
// ═══════════════════════════════════════════════════════════════════
// Window Methods
// ═══════════════════════════════════════════════════════════════════
//
// ctx.begin(name: string) -> bool
//   Push a window to the stack and start appending to it.
//   Returns true if the window is visible (not collapsed).
//   Always call ctx.end() after each ctx.begin(), regardless of return value.
//
// ctx.end() -> nil
//   Pop the current window from the stack.
//
// ═══════════════════════════════════════════════════════════════════
// Widget Methods
// ═══════════════════════════════════════════════════════════════════
//
// ctx.text(str: string) -> nil
//   Displays a text label.
//
// ctx.text_colored(str: string, r: f64, g: f64, b: f64, a: f64) -> nil
//   Displays colored text (RGBA, each 0.0–1.0).
//
// ctx.button(label: string) -> bool
//   Displays a button. Returns true if it was pressed this frame.
//
// ctx.checkbox(label: string, value: bool) -> bool
//   Displays a checkbox. Returns the new value.
//
// ctx.slider_float(label: string, value: f64, min: f64, max: f64) -> f64
//   Displays a float slider. Returns the new value.
//
// ctx.slider_int(label: string, value: i64, min: i64, max: i64) -> i64
//   Displays an integer slider. Returns the new value.
//
// ctx.input_text(label: string, value: string) -> string
//   Displays a single-line text input. Returns the new value.
//
// ctx.color_edit(label: string, r: f64, g: f64, b: f64) -> record{r: f64, g: f64, b: f64}
//   Displays a color picker. Returns the new RGB values (each 0.0–1.0).
//
// ctx.progress_bar(fraction: f64, size_x?: f64, size_y?: f64) -> nil
//   Displays a progress bar (fraction 0.0–1.0).
//
// ═══════════════════════════════════════════════════════════════════
// Layout Methods
// ═══════════════════════════════════════════════════════════════════
//
// ctx.same_line() -> nil
//   Call between widgets to append them on the same line.
//
// ctx.separator() -> nil
//   Draws a horizontal line separator.
//
// ctx.spacing() -> nil
//   Adds vertical spacing.
//
// ctx.indent() -> nil
//   Move content to the right (increase indent).
//
// ctx.unindent() -> nil
//   Move content to the left (decrease indent).
//
// ctx.newline() -> nil
//   Force a new line (in same-line mode).
//
// ═══════════════════════════════════════════════════════════════════
// Style Methods
// ═══════════════════════════════════════════════════════════════════
//
// ctx.style_colors_dark() -> nil
//   Sets the ImGui color scheme to Dark (recommended default).
//
// ctx.style_colors_light() -> nil
//   Sets the ImGui color scheme to Light.
//
// ctx.style_colors_classic() -> nil
//   Sets the ImGui color scheme to Classic.
//
// ctx.set_font_size(size: f64) -> nil
//   Sets the base font size (in pixels).
//