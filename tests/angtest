#!/bin/bash

# Configuration
COMPILER="angc"
TEST_DIR="tests"

echo "=========================================="
echo "      ANGARA TEST RUNNER (angtest)        "
echo "=========================================="

FAILED_SUITES=0
TOTAL_SUITES=0

# Loop through all .an files in the tests directory
for test_file in $TEST_DIR/test_*.an; do
    [ -e "$test_file" ] || continue

    TOTAL_SUITES=$((TOTAL_SUITES+1))

    # Extract base name (e.g., tests/test_math.an -> test_math)
    test_bin=$(basename "$test_file" .an)

    echo -n "Building $test_file ... "

    # 1. Compile
    $COMPILER "$test_file" > /dev/null 2>&1

    if [ $? -ne 0 ]; then
        echo "❌ BUILD FAILED"
        $COMPILER "$test_file" # Run again to show errors
        FAILED_SUITES=$((FAILED_SUITES+1))
        continue
    fi
    echo "OK"

    # 2. Run
    ./"$test_bin"

    # 3. Check Result
    if [ $? -ne 0 ]; then
        FAILED_SUITES=$((FAILED_SUITES+1))
        echo ""
    else
        echo ""
    fi

    # Cleanup binary
    rm "$test_bin"
done

echo "=========================================="
if [ $FAILED_SUITES -eq 0 ]; then
    echo -e "\033[32mALL SUITES PASSED ($TOTAL_SUITES/$TOTAL_SUITES)\033[0m"
    exit 0
else
    echo -e "\033[31mFAILURES DETECTED ($FAILED_SUITES/$TOTAL_SUITES)\033[0m"
    exit 1
fi