// Benchmark: computation-heavy test
// Sum of primes up to N, iterative
attach io;

func is_prime(n as i64) -> bool {
    if (n < 2) { return false; }
    if (n < 4) { return true; }
    if (n % 2 == 0) { return false; }
    if (n < 9) { return true; }
    if (n % 3 == 0) { return false; }
    let i = 5;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        if (n % (i + 2) == 0) { return false; }
        i = i + 6;
    }
    return true;
}

func count_primes(limit as i64) -> i64 {
    let count = 0;
    let i = 2;
    while (i < limit) {
        if (is_prime(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func main() {
    let result = count_primes(100000);
    io.println(1, "Primes below 100000: " + string(result));
}