// Chaperone negative test — E504 (reference cycle — self)
// An owned type owns itself directly, forming a cycle that would double-free
// under drop cascades. Must report E504 at type-declaration time.
//
// expect: E504

owned Node {
    let val as i64;
    let next as Node;   // self-cycle: Node -> Node
}

export func main() -> i64 {
    return 0;
}
