// Chaperone negative test — E504 (reference cycle — mutual)
// Two owned types own each other, forming an A -> B -> A cycle.
// Must report E504 at type-declaration time.
//
// expect: E504

owned A {
    let val as i64;
    let b as B;
}

owned B {
    let val as i64;
    let a as A;
}

export func main() -> i64 {
    return 0;
}
