// Chaperone negative test — E510 (branch asymmetry, now a hard error)
// A tracked variable is dropped on one branch of an if but not the other.
// The Chaperone must report E510 at the merge point and halt compilation.
//
// expect: E510

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    let cond as i64 = 1;
    if (cond > 0) {
        drop b;
    } else {
        // `b` not dropped on this path — handled differently
    }
    // E510: asymmetry detected — b is Dropped on one branch, Live on the other
    return 0;
}
