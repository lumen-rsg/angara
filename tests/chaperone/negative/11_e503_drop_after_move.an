// Chaperone negative test — E503 (drop after move, double-free via move)
// After ownership moves, dropping the MOVED-FROM source would double-free
// the object the destination still owns. Must report E503.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b1 = Buf(42);
    let b2 = b1;   // MOVE: b1 invalid, b2 owns it
    drop b1;       // dropping the moved-from source — double-free
    drop b2;
    return 0;
}
