// Chaperone negative test — E502 (use-after-free in a for-loop condition, S2)
// The for-loop condition reads a tracked variable that was dropped. The
// Chaperone must now analyze for-loop conditions, not just bodies.
//
// expect: E502

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

export func main() -> i64 {
    let b = Buf(3);
    drop b;
    for (let i as i64 = 0; b.get() > 0; i = i + 1) {   // use-after-free in condition
        i = i;
    }
    return 0;
}
