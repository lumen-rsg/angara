// Chaperone negative test — E505 (tracked value escapes into untracked container, G4)
// Storing a Live tracked allocation into an untracked container (tuple)
// loses the ability to drop it correctly — the container isn't tracked, so the
// allocation either leaks (container dropped without cascade) or double-frees
// (caller also drops). The Chaperone must report E505 and require @escape or
// an owning container.
// Phase B: lists and records are now tracked, so this test uses a tuple
// (the only remaining untracked container type).
//
// expect: E505

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    let t = (b, 42);            // tuple — untracked container
    drop b;                      // E505: b escaped into the tuple
    return 0;
}
