// Chaperone negative test — E505 (tracked value captured by a closure, G2)
// A closure that references a tracked Live value captures it — the closure may
// outlive the local, so ownership is treated as transferred (E505). The
// Chaperone previously treated LambdaExpr as a no-op, so captures were invisible.
//
// expect: E505

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

export func main() -> i64 {
    let b = Buf(42);
    // Closure captures b by reference.
    let f = func() -> i64 { return b.get(); };
    drop b;          // b freed, but the closure still references it
    let r = f();     // use-after-free — the closure reads freed memory
    return r;
}
