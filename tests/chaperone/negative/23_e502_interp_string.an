// Chaperone negative test — E502 via InterpStringExpr (C2)
// InterpStringExpr was previously unhandled in analyzeExpr, so a dropped
// tracked variable in an interpolated string ($"...{x}...") would go
// undetected. Must fire E502 when the variable is used after drop.
//
// expect: E502

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    drop b;
    let s = $"buf is {b}";  // b used after drop in interpolated string
    return 0;
}
