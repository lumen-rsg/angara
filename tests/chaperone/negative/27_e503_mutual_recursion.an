// Chaperone negative test — E503 (double-drop via mutual recursion, M4)
// func a() calls b(), which calls a() — mutual recursion. The fixed-point
// must converge and detect that b drops its argument, so dropping after
// calling b is a double-free.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    a(b);          // a → b → a → ... b eventually drops the arg
    drop b;        // double-drop — b was already consumed
    return 0;
}

func a(x as Buf) -> nil {
    b(x);          // forward reference: calls b with same arg
}

func b(x as Buf) -> nil {
    drop x;        // b takes ownership and drops
}
