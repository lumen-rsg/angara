// Chaperone negative test — E503 (double-drop via forward reference)
// func a() calls b() — forward reference (b defined after a). The fixed-point
// must converge and detect that b drops its argument, so dropping after
// calling a is a double-free.
// Note: this is forward-reference, not mutual recursion. For true A→B→A
// mutual recursion, see test 34.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    a(b);          // a → b → a → ... b eventually drops the arg
    drop b;        // double-drop — b was already consumed
    return 0;
}

func a(x as Buf) -> nil {
    b(x);          // forward reference: calls b with same arg
}

func b(x as Buf) -> nil {
    drop x;        // b takes ownership and drops
}
