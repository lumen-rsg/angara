// Chaperone negative test — E503 (closure drops argument, then explicit drop)
// A closure that drops its argument transitions the arg to Dropped.
// An explicit drop afterward is double-free.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    let f = func(x as Buf) {
        drop x;
    };
    f(b);
    drop b;  // E503: b already dropped by closure
    return 0;
}
