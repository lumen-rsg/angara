// Chaperone negative test — M2 (conditional move inside loop body, E506)
// A tracked variable allocated before a loop is moved conditionally inside
// an if/else within the loop body. The merged state hides the move, but on
// the path where it was moved it won't be available on iteration 2+.
//
// expect: E506

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    let i as i64 = 0;
    while (i < 3) {
        if (i == 0) {
            let stolen = b;   // b moved on this path only
            drop stolen;
        } else {
            // b stays Live — merge masks the move
        }
        i = i + 1;
    }
    return 0;
}
