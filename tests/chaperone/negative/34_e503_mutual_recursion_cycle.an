// Chaperone negative test — E503 (double-drop via true mutual recursion, M4)
// True A→B→A cycle: a calls b, b calls a back. The fixed-point must converge
// and detect that both functions may drop their argument. Dropping after
// calling a is a double-free.
//
// Unlike test 27 (forward-reference a→b→drop, no cycle), this test has a
// genuine call-graph cycle requiring the fixed-point to iterate to convergence.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    a(b);          // a → b → a → ... b eventually drops the arg
    drop b;        // double-drop — b was already consumed
    return 0;
}

func a(x as Buf) -> nil {
    b(x);          // passes to b
}

func b(x as Buf) -> nil {
    a(x);          // mutual recursion: calls a back
    drop x;        // after a returns, drop (statically both may drop)
}
