// Chaperone negative test — E501: leak inside try whose finally has a drop
// inside a loop body (not guaranteed to execute — loop may iterate zero times).
// L25: The recursive scan correctly excludes loop-body drops from the
// guaranteed set, so the throw inside the try still flags E501 for `b`.
//
// expect: E501

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

export func main() -> i64 {
    let b = Buf(42);
    try {
        throw Exception("error");
    } catch (e) {
        // unused
    } finally {
        // Drop inside a loop: not guaranteed (loop may execute zero times).
        while (false) {
            drop b;
        }
    }
    // b leaks here — the finally's loop didn't execute.
    return 0;
}
