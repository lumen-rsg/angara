// Chaperone negative test — E503 (double drop on field, H8)
// Dropping a field twice is a double-free. The Chaperone must detect
// the second drop and emit E503.
//
// expect: E503

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

class Holder {
    let inner as Buf;
    func init(this) {
        this.inner = Buf(1);
    }
    public:
    func double_drop_field(this) -> nil {
        drop this.inner;
        drop this.inner;   // E503: already dropped
    }
}

export func main() -> i64 {
    let h = Holder();
    h.double_drop_field();
    return 0;
}
