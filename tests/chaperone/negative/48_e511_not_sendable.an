// Chaperone negative test — M11: E511 non-Send type passed to spawn.
//
// A class with @unsendable cannot be transferred across thread boundaries
// via spawn(). The Chaperone must detect this and report E511.
//
// expect: E511

@unsendable
class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

func worker(b as Buf) -> nil {
    drop b;
}

export func main() -> i64 {
    let b = Buf(42);
    let t = spawn(worker, b);  // E511: Buf is @unsendable
    t.join();
    drop t;
    return 0;
}
