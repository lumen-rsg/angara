// Chaperone negative test — M11: E511 non-@sendable type passed to spawn.
//
// Only types marked @sendable (or data types, which are implicitly sendable)
// can be transferred across thread boundaries via spawn(). A class/owned type
// without @sendable passed to spawn() must trigger E511.
//
// expect: E511

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

func worker(b as Buf) -> nil {
    drop b;
}

export func main() -> i64 {
    let b = Buf(42);
    let t = spawn(worker, b);  // E511: Buf is not @sendable
    t.join();
    drop t;
    return 0;
}
