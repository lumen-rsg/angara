// Chaperone negative test — E507 (use-after-move with generic type parameter, M13)
// When a generic function moves ownership from a parameter of type T into
// a local variable, the parameter becomes Moved. Subsequent use of the
// moved parameter must be flagged as E507. Before M13, generic type
// parameters were invisible to the Chaperone and this passed silently.
//
// expect: E507

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

// Generic move: x is moved into y, then x is used again — error.
func use_after_move<T>(x as T) -> T {
    let y = x;   // move x → y (x becomes Moved)
    return x;    // E507: use-after-move of x
}

export func main() -> i64 {
    let b = Buf(42);
    let r = use_after_move(b);  // would be unsound at runtime
    drop r;
    return 0;
}
