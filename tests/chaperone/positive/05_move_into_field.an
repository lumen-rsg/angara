// Chaperone positive test — move into a field inside a method (S6).
// Inside a method, `this.f = tracked_local` MOVES the local's ownership into
// the field. The source becomes invalid; only the owning object is dropped
// (which cascades to the field). Using the source afterward would be E507.
//
// exit: 0

class Inner {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

class Outer {
    let inner as Inner;
    func init(this) { this.inner = Inner(0); }
    public:
    func set(this, i as Inner) -> nil {
        this.inner = i;   // MOVE: i's ownership transfers into this.inner
    }
}

export func main() -> i64 {
    let o = Outer();
    let i = Inner(42);
    o.set(i);       // i moves into o.inner
    drop o;         // cascades → frees the moved inner
    return 0;       // i is invalid here (moved), not dropped → no double-free
}
