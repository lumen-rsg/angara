// Chaperone positive test — closure call summary (borrow case).
// A closure that only reads its argument (no drop/escape) leaves it Live.
// The caller must still drop it explicitly. Verifies no false positive.
//
// exit: 42

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

export func main() -> i64 {
    let b = Buf(42);
    let f = func(x as Buf) -> i64 {
        return x.get();
    };
    let result = f(b);
    drop b;
    return result;
}
