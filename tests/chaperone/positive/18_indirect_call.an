// Chaperone positive test — indirect call through function pointer.
// f is a variable holding a function pointer to borrow(), which does not drop
// its argument. The Chaperone tracks function pointer aliases (H10) and
// resolves indirect calls to the aliased function's summary. Since borrow()
// only borrows, the argument stays Live and the subsequent drop is valid.
//
// Note: if the function pointer variable is reassigned after being initialized
// (e.g. `f = other_func;`), the alias is updated. Unresolvable indirect calls
// (e.g. function pointers received as parameters) still default to Borrow.
//
// exit: 0

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

// Regular function: borrows tracked param (does not drop).
func borrow(b as Buf) -> nil {
    // b is borrowed, not dropped
}

export func main() -> i64 {
    let b = Buf(42);
    let f = borrow;      // f: function(Buf) -> nil
    f(b);                // indirect call — Chaperone treats as Borrowed
    drop b;              // ok: b genuinely only borrowed
    return 0;
}
