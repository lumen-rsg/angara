// Chaperone positive test — closure stored in local, called before captures dropped (L21).
// A non-IIFE closure stored in a local variable that is called synchronously
// before the captured variable is dropped should NOT trigger E505.
// The deferred E505 check fires at the drop point, but since the closure
// was already called, the captures are resolved.
//
// exit: 42

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

export func main() -> i64 {
    let b = Buf(42);
    // Store closure in local — captures b.
    let f = func() -> i64 { return b.get(); };
    // Call the closure synchronously — resolves the capture reference.
    let result = f();
    // Now safe to drop b — no pending closure references.
    drop b;
    return result;
}
