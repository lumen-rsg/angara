// Chaperone positive test — closure aliased via assignment, both called (L21).
// When a closure is copied to another variable (let g = f), both variables
// hold capture references. Both must be called before the captured variable
// can be safely dropped. This test verifies that calling both aliases
// resolves all pending captures.
//
// exit: 84

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
    public:
    func get(this) -> i64 { return this.v; }
}

export func main() -> i64 {
    let b = Buf(42);
    // Store closure in f — captures b.
    let f = func() -> i64 { return b.get(); };
    // Alias: g also holds the closure and its capture references.
    let g = f;
    // Call both — all capture references resolved.
    let r1 = f();
    let r2 = g();
    // Now safe to drop b.
    drop b;
    return r1 + r2;  // 42 + 42 = 84
}
