// Chaperone positive test — M11: @sendable type passed to spawn.
//
// A class marked @sendable is safe to transfer across thread boundaries.
// The Chaperone must accept this without errors.
//
// exit: 0

@sendable
class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

func worker(b as Buf) -> nil {
    drop b;
}

export func main() -> i64 {
    let b = Buf(42);
    let t = spawn(worker, b);
    // b is now owned by the worker thread — correctly not used here.
    t.join();
    drop t;
    return 0;
}
