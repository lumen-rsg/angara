// Chaperone positive test — M11: valid spawn ownership transfer.
//
// A tracked value is passed to spawn(), ownership transfers cleanly to the
// worker thread. No use-after-transfer or double-drop in the parent.
// The Chaperone must accept this without errors.
//
// exit: 0

class Buf {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

// Worker function that takes ownership and drops the buffer.
func worker(b as Buf) -> nil {
    drop b;
}

export func main() -> i64 {
    let b = Buf(42);
    let t = spawn(worker, b);
    // b is now owned by the worker thread — correctly not used here.
    // t is a Thread handle — must be tracked.
    t.join();
    drop t;
    return 0;
}
