        test_inheritance();
        test_optionals();
        test_generics();
        test_concurrency();
        test_type_inspection();
        test_interactions();
        test_memory_pressure();
        test_operators();
        test_loop_edges();
        test_conversions();
        test_recursive_stress();

        io.println(1, "\n============================================");
        io.println(1, "  ALL 21 SECTIONS PASSED");
        io.println(1, "  No crashes, no assertion failures.");
        io.println(1, "============================================");
        return 0;
    } catch (e as Exception) {
        io.println(2, "\n[UNEXPECTED EXCEPTION]");
        io.println(2, "  " + e.message);
        return 1;
    }
}
