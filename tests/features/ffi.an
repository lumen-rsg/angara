// FFI Test — Marshalling-based foreign function interface
// No c_ptr, no retype, no sizeof in user code

foreign func abs(x as i64) -> i64;
foreign func strlen(s as string) -> i64;

foreign data utsname {
    sysname as i8[256];
    nodename as i8[256];
    release as i8[256];
    version as i8[256];
    machine as i8[256];
}

foreign func uname(buf as utsname) -> i32;

// Callback test — userdata-based callbacks with return values
// reduce_sum: calls fn(element, userdata) for each element, returns sum of results
foreign func reduce_sum(arr as *void, count as i32,
                        fn as function(i64, *void) -> i64,
                        userdata as *void) -> i64;

foreign func malloc(size as u64) -> *void;

attach io;

export func main() -> i64 {
    // Primitive FFI
    let v = abs(-42);
    if (v == 42) {
        io.println(1, "abs(-42) = 42 OK");
    }

    let n = strlen("hello");
    if (n == 5) {
        io.println(1, "strlen OK");
    }

    // Struct FFI with inline char arrays
    let info = utsname();
    let result as i32 = uname(info);

    if (result < 0) {
        io.println(2, "uname() failed.");
        return 1;
    }

    io.println(1, "  OS: " + info.sysname);
    io.println(1, "  Node: " + info.nodename);
    io.println(1, "  Release: " + info.release);
    io.println(1, "  Machine: " + info.machine);

    // Callback FFI — userdata-based callback with reduce_sum
    // Allocate space for 5 i64 values (uninitialized, we just return 1 per element)
    let arr = malloc(5 * 8 as u64);

    let sum = reduce_sum(arr, 5 as i32, func(elem as i64, ud as *void) -> i64 {
        return 1 as i64;  // count elements by returning 1 each time
    });

    if (sum == 5) {
        io.println(1, "userdata callback OK");
    } else {
        io.println(2, "userdata callback FAIL");
    }

    return 0;
}
