// FFI Test — Marshalling-based foreign function interface
// No c_ptr, no retype, no sizeof in user code

foreign func abs(x as i64) -> i64;
foreign func strlen(s as string) -> i64;

foreign data utsname {
    sysname as i8[256];
    nodename as i8[256];
    release as i8[256];
    version as i8[256];
    machine as i8[256];
}

foreign func uname(buf as utsname) -> i32;

attach io;

export func main() -> i64 {
    // Primitive FFI
    let v = abs(-42);
    if (v == 42) {
        io.println(1, "abs(-42) = 42 OK");
    }

    let n = strlen("hello");
    if (n == 5) {
        io.println(1, "strlen OK");
    }

    // Struct FFI with inline char arrays
    let info = utsname();
    let result as i32 = uname(info);

    if (result < 0) {
        io.println(2, "uname() failed.");
        return 1;
    }

    io.println(1, "  OS: " + info.sysname);
    io.println(1, "  Node: " + info.nodename);
    io.println(1, "  Release: " + info.release);
    io.println(1, "  Machine: " + info.machine);

    return 0;
}
