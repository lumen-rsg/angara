attach io;
attach adv_string;

// Test levenshtein distance

export func main() -> i64 {
    io.println(1, "=== Levenshtein Distance Tests ===");

    let d = adv_string.levenshtein("kitten", "sitting");
    io.println(1, "kitten -> sitting: " + string(d));

    if (d != 3) {
        io.println(1, "FAIL: expected 3, got " + string(d));
        return 1;
    }

    let d2 = adv_string.levenshtein("", "abc");
    io.println(1, "'' -> 'abc': " + string(d2));

    if (d2 != 3) {
        io.println(1, "FAIL: expected 3, got " + string(d2));
        return 1;
    }

    let d3 = adv_string.levenshtein("same", "same");
    io.println(1, "same -> same: " + string(d3));

    if (d3 != 0) {
        io.println(1, "FAIL: expected 0, got " + string(d3));
        return 1;
    }

    io.println(1, "=== Levenshtein Distance Tests Passed ===");
    return 0;
}
