// Angara Match Expression Test — LANG-7 enhanced patterns
attach io;

// --- Enum Definitions ---
enum Color {
    Red,
    Green,
    Blue
}

enum MoveEvent {
    PageLoad,
    Move(i64, i64)
}

export func main() -> i64 {
    io.println_auto("--- Angara LANG-7 Match Expression Test ---");

    // --- 1. Basic enum matching (existing functionality) ---
    io.println_auto("1. Basic enum matching...");
    let c = Color.Red;
    let desc = match (c) {
        case Color.Red: "red",
        case Color.Green: "green",
        case Color.Blue: "blue",
        case _: "other"
    };
    io.println_auto(desc);

    // --- 2. Multi-payload destructuring ---
    io.println_auto("2. Multi-payload destructuring...");
    let mv = MoveEvent.Move(10, 20);
    let desc2 = match (mv) {
        case MoveEvent.PageLoad: "pageload",
        case MoveEvent.Move(a, b): "move",
        case _: "other"
    };
    io.println_auto(desc2);

    // --- 3. Or-patterns ---
    io.println_auto("3. Or-patterns...");
    let c2 = Color.Blue;
    let desc3 = match (c2) {
        case Color.Red | Color.Green: "warm",
        case Color.Blue: "cool",
        case _: "other"
    };
    io.println_auto(desc3);

    // --- 4. Guards ---
    io.println_auto("4. Guards...");
    let mv2 = MoveEvent.Move(100, 200);
    let desc4 = match (mv2) {
        case MoveEvent.Move(px, py) if px > 50: "large",
        case MoveEvent.Move(qx, qy): "small",
        case _: "other"
    };
    io.println_auto(desc4);

    // --- 5. Integer literal match ---
    io.println_auto("5. Integer match...");
    let n = 42;
    let desc5 = match (n) {
        case 1: "one",
        case 42: "forty-two",
        case _: "other"
    };
    io.println_auto(desc5);

    // --- 6. String literal match ---
    io.println_auto("6. String match...");
    let s = "hello";
    let desc6 = match (s) {
        case "hi": "greeting",
        case "hello": "hello_world",
        case _: "unknown"
    };
    io.println_auto(desc6);

    // --- 7. Bool literal match ---
    io.println_auto("7. Bool match...");
    let bb = true;
    let desc7 = match (bb) {
        case true: "yes",
        case false: "no"
    };
    io.println_auto(desc7);

    // --- 8. Or-pattern with guard ---
    io.println_auto("8. Or-pattern with guard...");
    let mv3 = MoveEvent.Move(0, 0);
    let desc8 = match (mv3) {
        case MoveEvent.Move(rx, ry) if rx == 0: "origin",
        case MoveEvent.Move(sx, sy): "elsewhere",
        case _: "other"
    };
    io.println_auto(desc8);

    io.println_auto("--- Test Complete ---");
    return 0;
}
