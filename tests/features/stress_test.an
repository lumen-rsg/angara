attach io;
attach assert;

// --- 1. Data Structures ---
data Vector3 {
    let x as i64;
    let y as i64;
    let z as i64;
}

data Container {
    let id as i64;
    let items as list<string>;
}

// --- 2. Enum ---
enum ProcessState {
    Idle,
    Running(i64), // Progress 0-100
    Error(string),
    Done
}

// --- 3. Class for Threading ---
class SharedCounter {
    public:
    let value as i64;
    let mtx as Mutex;

    func init() {
        this.value = 0;
        this.mtx = Mutex();
    }

    func increment() {
        this.mtx.lock();
        let temp = this.value;
        this.value = temp + 1;
        this.mtx.unlock();
    }
}

// --- TEST 1: Recursion (Stack Stress) ---
func fib(n as i64) -> i64 {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

func test_recursion() {
    io.println(1, "[Stress] Recursion (Fibonacci)...");
    // fib(25) is roughly 121k recursive calls
    let res = fib(25);
    assert.eq(res, 75025, "Fibonacci(25) result");
}

// --- TEST 2: Allocation Churn (Heap Stress) ---
func test_vector_math() {
    io.println(1, "[Stress] Vector Allocation (100k objects)...");

    let result = Vector3(0, 0, 0);

    // Create and discard 100,000 objects rapidly
    for (let i = 0; i < 100000; i++) {
        let v1 = Vector3(1, 2, 3);
        let v2 = Vector3(4, 5, 6);
        // This creates a new Vector3 every iteration
        result = Vector3(result.x + 1, result.y + 1, result.z + 1);
    }

    assert.eq(result.x, 100000, "Vector accumulation X");
}

// --- TEST 3: Pattern Matching & Enums ---
func process_logic(state as ProcessState) -> string {
    return match (state) {
        case ProcessState.Idle: "Waiting",
        case ProcessState.Running(p): (p < 50 ? "Starting" : "Finishing"),
        case ProcessState.Error(msg): "Failed: " + msg,
        case ProcessState.Done: "Success",
        case _: "Unknown"
    };
}

func test_enums() {
    io.println(1, "[Stress] Enum Pattern Matching...");

    assert.eq(process_logic(ProcessState.Idle), "Waiting", "Enum Idle");
    assert.eq(process_logic(ProcessState.Running(10)), "Starting", "Enum Running Low");
    assert.eq(process_logic(ProcessState.Error("Timeout")), "Failed: Timeout", "Enum Error");

    // Enum Equality
    let e1 = ProcessState.Running(50);
    let e2 = ProcessState.Running(50);
    assert.eq(e1, e2, "Enum Structural Equality");
}

// --- TEST 4: Concurrency ---
func worker_task(counter as SharedCounter, iterations as i64) {
    for (let i = 0; i < iterations; i++) {
        counter.increment();
    }
}

func test_concurrency() {
    io.println(1, "[Stress] Threads & Mutexes...");

    let counter = SharedCounter();
    let threads as list<Thread> = [];
    let num_threads = 5;
    let ops_per_thread = 1000;

    for (let i = 0; i < num_threads; i++) {
        let t = spawn(worker_task, counter, ops_per_thread);
        threads.push(t);
    }

    for (let i = 0; i < num_threads; i++) {
        threads[i].join();
    }

    let expected = num_threads * ops_per_thread;
    assert.eq(counter.value, expected, "Threaded counter value");
    drop counter;
}

// --- TEST 5: Clone vs Deep Clone (Memory Model Stress) ---
func test_copy_semantics() {
    io.println(1, "[Stress] Deep vs Shallow Copy Semantics...");

    // Setup: A complex record containing a mutable list
    let original = {
        "id": 1,
        "tags": ["alpha", "beta"],
        "meta": Vector3(10, 20, 30)
    };

    // --- Phase A: Shallow Clone ---
    // 'shallow' is a new Record, but "tags" points to the SAME List object in memory.
    let shallow = original.clone();

    // Modify the nested list via the clone
    shallow["tags"].push("gamma");

    // ASSERT: The original SHOULD be affected because the list was shared.
    assert.eq(len(original["tags"]), 3, "Shallow Copy: Original sees modification");
    assert.eq(original["tags"][2], "gamma", "Shallow Copy: Content check");

    // --- Phase B: Deep Clone ---
    // 'deep' is a recursive copy. "tags" is a NEW List object.
    let deep = original.deep_clone();

    // Modify the nested list via the deep clone
    deep["tags"].push("delta");

    // ASSERT: The original should NOT be affected (length remains 3).
    assert.eq(len(original["tags"]), 3, "Deep Copy: Original ignored modification");

    // ASSERT: The deep clone DOES have the new item (length is 4).
    assert.eq(len(deep["tags"]), 4, "Deep Copy: Clone has modification");
    assert.eq(deep["tags"][3], "delta", "Deep Copy: Content check");

    // ASSERT: Structural Equality check (Generic Runtime)
    // deep currently has "delta", original doesn't. They should be NE.
    assert.ne(original, deep, "Structural Inequality check");
}

func test_struct_deep_copy() {
    io.println(1, "[Stress] Struct Deep Copy...");

    // 1. Create original
    let c1 = Container(1, ["a", "b"]);

    // 2. Shallow Clone
    let c2 = c1.clone();
    // 3. Deep Clone
    let c3 = c1.deep_clone();

    // Modify the list inside the clones
    c2.items.push("shallow_add"); // Should affect c1
    c3.items.push("deep_add");    // Should NOT affect c1

    // ASSERTIONS

    // c1 should have "shallow_add" but NOT "deep_add"
    assert.eq(len(c1.items), 3, "Original sees shallow modification");
    assert.eq(c1.items[2], "shallow_add", "Original has shallow item");

    // c3 should have "deep_add" and its original items
    assert.eq(len(c3.items), 3, "Deep clone has its own modification");
    assert.eq(c3.items[2], "deep_add", "Deep clone has deep item");

    // c1 and c3 items should be totally different objects
    assert.ne(c1.items, c3.items, "Lists are distinct objects");
}

export func main() -> i64 {
    try {
        io.println(1, "==========================================");
        io.println(1, "    ANGARA COMPILER STRESS TEST SUITE     ");
        io.println(1, "==========================================");

        test_recursion();
        test_vector_math();
        test_enums();
        test_concurrency();
        test_copy_semantics();
        test_struct_deep_copy();

        io.println(1, "\n==========================================");
        io.println(1, "    STATUS: ALL SYSTEMS NOMINAL           ");
        io.println(1, "==========================================");
        return 0;
    } catch (e as Exception) {
        io.println(2, "\n[CRITICAL FAILURE]");
        io.println(2, e.message);
        return 1;
    }
}