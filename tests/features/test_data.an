attach io;

// Test data classes

data Point {
    let x as i64;
    let y as i64;
}

export func main() -> i64 {
    io.println(1, "=== Data Class Tests ===");

    let p = Point(10, 20);
    io.println(1, "Created Point");

    let x = p.x;
    let y = p.y;

    io.println(1, "Point x: " + string(x));
    io.println(1, "Point y: " + string(y));

    io.println(1, "=== Data Class Tests Passed ===");
    return 0;
}
