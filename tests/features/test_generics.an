// Angara Generics Test — no external modules needed

// --- Test 1: Generic data type ---
data Box<T> {
    let value as T;
}

// --- Test 2: Generic data type with multiple params ---
data Pair<K, V> {
    let key as K;
    let val as V;
}

// --- Test 3: Generic function ---
func identity<T>(x as T) -> T {
    return x;
}

// --- Test 4: Non-generic data still works ---
data Point {
    let x as i64;
    let y as i64;
}

// --- Test 5: Using generic types ---
func main() {
    // Create a Box (all values are AngaraObject at runtime)
    let int_box = Box(42);
    let str_box = Box("hello");

    // Create a Pair
    let entry = Pair("age", 30);

    // Test identity function
    let result = identity("hello generics");

    // Non-generic data still works
    let p = Point(10, 20);
}