// Freestanding smoke test: a program with try/catch must compile under
// --freestanding without crashing the compiler. (Both trivial and try/catch
// programs used to SIGSEGV at IR-build time — generateMemoryManagement
// dereferenced null malloc/realloc/free, and cgTry dereferenced null setjmp.)
// expect: PASS
// mode: --freestanding
export func main() -> i64 {
    try {
        return 1;
    } catch (e as Exception) {
        return 0;
    }
}
