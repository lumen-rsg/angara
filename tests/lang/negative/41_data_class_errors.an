// M21: negative tests for data class field access errors.
// expect: E334
// expect: E334

data Point {
    let x as i64;
    let y as i64;
}

export func main() -> i64 {
    let p = Point(1, 2);

    // E334: reading a non-existent field on a data class
    let z = p.nonexistent;

    // E334: assigning to a non-existent field on a data class
    p.missing = 5;

    return 0;
}
