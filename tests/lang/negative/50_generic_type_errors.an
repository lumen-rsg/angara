// M21: negative tests for generic type argument errors
// (wrong number of type args, missing type args).
// The type annotation parser rejects malformed generic type annotations
// before the generic-specific checks (E251/E411) can fire.
// expect: E208
// expect: E208

// A generic data type expecting one type argument
data Box<T> {
    let value as T;
}

export func main() -> i64 {
    // E208: Box without type args fails at type annotation parsing
    let b1: Box = Box(42);

    // E208: Box<i64, string> — too many type args fails at parsing
    let b2: Box<i64, string> = Box(42);

    return 0;
}
