// M21: negative tests for generic type argument errors
// (wrong number of type args, missing type args).
// expect: E251
// expect: E411

// A generic data type expecting one type argument
data Box<T> {
    let value as T;
}

export func main() -> i64 {
    // E251: generic type expects exactly one type argument
    let b1: Box = Box(42);

    // E411: wrong number of type arguments for generic type
    let b2: Box<i64, string> = Box(42);

    return 0;
}
