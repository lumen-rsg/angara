// M11: Generic bounds failure — non-Send type used where T: Send required.
//
// expect: E391

@unsendable
class Secret {
    let v as i64;
    func init(this, x as i64) { this.v = x; }
}

// Generic function requiring T to be Send.
func send_it<T: Send>(x as T) -> i64 {
    return 42;
}

export func main() -> i64 {
    let s = Secret(99);
    let r = send_it(s);  // E391: Secret is @unsendable → not Send
    return r;
}
