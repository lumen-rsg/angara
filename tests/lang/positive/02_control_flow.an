// Test 02: Control flow statements (if/else, while, for, break, continue, ternary)
attach io;

export func main() -> i64 {
    // if / else if / else
    let x = 42;
    if (x > 50) {
        io.println(1, "big");
    } else if (x > 20) {
        io.println(1, "medium");      // medium
    } else {
        io.println(1, "small");
    }

    // orif keyword
    let y = 5;
    if (y == 1) {
        io.println(1, "one");
    } orif (y == 5) {
        io.println(1, "five");        // five
    } else {
        io.println(1, "other");
    }

    // while loop with break
    let i = 0;
    while (true) {
        if (i == 5) { break; }
        i = i + 1;
    }
    io.println(1, string(i));         // 5

    // while loop with continue
    let sum = 0;
    let j = 0;
    while (j < 10) {
        j = j + 1;
        if (j % 2 == 0) { continue; }
        sum = sum + j;
    }
    io.println(1, string(sum));       // 25 (1+3+5+7+9)

    // C-style for loop
    let product = 1;
    for (let k = 1; k < 6; k = k + 1) {
        product = product * k;
    }
    io.println(1, string(product));   // 120

    // for-in loop
    let total = 0;
    let items = [10, 20, 30];
    for (item in items) {
        total = total + item;
    }
    io.println(1, string(total));     // 60

    // Nested loops
    let count = 0;
    for (let a = 0; a < 3; a = a + 1) {
        for (let b = 0; b < 3; b = b + 1) {
            count = count + 1;
        }
    }
    io.println(1, string(count));     // 9

    // Ternary expression
    let val1 = true ? 42 : 99;
    let val2 = false ? 42 : 99;
    io.println(1, string(val1));      // 42
    io.println(1, string(val2));      // 99

    return 0;
}