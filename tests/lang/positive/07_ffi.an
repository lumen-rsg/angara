// Test 07: Foreign function interface (FFI)
attach io;

// Modern FFI: declare the C function signature directly with `foreign func`.
// No header include is needed — the compiler infers linkage from the signature
// and links against libc automatically.
foreign func abs(val as i64) -> i64;

export func main() -> i64 {
    // Call a C stdlib function like any Angara function.
    let v = abs(-42);
    io.println(1, string(v));               // 42

    let v2 = abs(10);
    io.println(1, string(v2));              // 10

    return 0;
}
