// TS-7b positive case: comparing `any` with a typed value is allowed inside @unsafe.
attach io;

func main() -> i64 {
    let items as list<any> = [true, false, true];
    let count = 0;
    let i = 0;
    while (i < len(items)) {
        @unsafe {
            if (items[i] == true) {
                count = count + 1;
            }
        }
        i = i + 1;
    }
    io.println(0, "true count = " + string(count));
    return 0;
}
