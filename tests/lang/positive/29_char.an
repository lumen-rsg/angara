// LANG-4: char type + single-quote char literals ('a').
// exit: 0
//
// Model: char is a 32-bit unsigned integer (a Unicode code point) that also
// renders as a glyph. 'A'+1 == 66 (promotes to i64), 'A'==65 is true, and a
// char-typed value prints as the character, not the number.
attach io;

export func main() -> i64 {
    // 1. Basic char literal + explicit type annotation.
    let c as char = 'A';
    io.println_auto($"c = {c}");                       // c = A   (glyph, not 65)

    // 2. char widens to i64 in mixed arithmetic (C/Java model).
    io.println_auto($"'A' + 1 = {'A' + 1}");           // 'A' + 1 = 66
    io.println_auto($"'A' == 65 -> {'A' == 65}");      // 'A' == 65 -> true
    io.println_auto($"'a' > 'Z' -> {'a' > 'Z'}");      // 'a' > 'Z' -> true

    // 3. char-typed value renders as a glyph via string() and interpolation.
    io.println_auto(string('A'));                      // A
    io.println_auto($"glyph: {c}");                    // glyph: A

    // 4. char is an integer, not a string — to concat with a string, convert
    //    it explicitly. The conversion renders the glyph.
    io.println_auto("letter = " + string(c));          // letter = A
    io.println_auto(string(c) + "!");                  // A!

    // 5. Assignment / widening: char flows into an i64 slot (value is the cp).
    let n as i64 = 'A';
    io.println_auto($"n = {n}");                       // n = 65
    io.println_auto($"cast = {'A' as i64}");           // cast = 65

    // 6. char(x) conversion from an integer code point.
    let from_cp as char = char(66);
    io.println_auto($"from_cp = {from_cp}");           // from_cp = B

    // 7. Escape sequences (same set as strings).
    io.println_auto($"'\\n' == 10 -> {'\n' == 10}");   // '\n' == 10 -> true
    io.println_auto($"'\\t' == 9 -> {'\t' == 9}");     // '\t' == 9 -> true
    io.println_auto($"'\\0' == 0 -> {'\0' == 0}");     // '\0' == 0 -> true
    io.println_auto(string('\x41'));                   // A   (hex escape)
    io.println_auto(string('\\'));                     // \   (escaped backslash)
    io.println_auto(string('\''));                     // '   (escaped quote)

    // 7b. LANG-5: Unicode escapes in char literals.
    io.println_auto(string('\u{41}'));                     // A (braced)
    io.println_auto(string('\u0041'));                     // A (4-digit)
    io.println_auto(string('\U00000041'));                 // A (8-digit)
    io.println_auto(string('\u{1F600}'));                  // 😀 (emoji)
    io.println_auto(string('\u{E9}'));                     // é (U+00E9)
    io.println_auto(string('\u{20AC}'));                   // € (U+20AC)
    io.println_auto($"u{41} eq 65: {'\u{41}' == 65}");    // true
    io.println_auto($"u{0x1F600} eq 128512: {'\u{1F600}' == 128512}"); // true

    // 7c. LANG-5: Unicode escapes in string literals.
    io.println_auto("\u{41}");                             // A
    io.println_auto("\u{1F600}");                          // 😀
    io.println_auto("\u{48}\u{69}");                        // Hi

    // 8. list<char> works through the generic collection machinery.
    let chars = ['H', 'i', '!'];
    io.println_auto($"chars[0] = {chars[0]}");         // chars[0] = H

    // 9. *char now resolves as an FFI pointer type (pointee is the char type).
    //    (Compile-only check; no dereference needed to exercise the type table.)
    return 0;
}

// 9 (cont.): *char in a foreign-style data declaration compiles.
data CharPtr { let p as *char; }
