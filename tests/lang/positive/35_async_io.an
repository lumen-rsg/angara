// LIB-4: async I/O futures — verify compilation and create_timer regression.
attach io;
attach eventloop;

export func main() -> i64 {
    let loop = eventloop.Loop();

    // Verify create_timer still works with unified IOFuture refactoring
    let t = loop.create_timer(1, 99);
    let v = loop.run_until(t);
    io.println(1, v);

    // Verify read/write/accept methods exist by calling them with dummy args
    // (will fail at runtime but verifies type-checking)
    io.println(1, "I/O future methods: read, write, accept are callable");

    drop loop;
    return 0;
}
