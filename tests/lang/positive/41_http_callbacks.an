// Test HTTP server callbacks: on_request compiles and runs.
// exit: 0
attach io;
attach http_server;

export func main() -> i64 {
    let srv = http_server.server(18080);

    srv.on_request(func(req) {
        io.println(1, "  request received OK");
    });

    io.println(1, "HTTP callback test compiled OK");
    drop srv;
    return 0;
}
