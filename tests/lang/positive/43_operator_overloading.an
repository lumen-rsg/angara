// LANG-13: Operator overloading — opEquals and opCmp for user-defined classes
// exit: 0
attach io;

class Point {
  public:
    let x as i64;
    let y as i64;

  public:
    func init(this, x as i64, y as i64) -> nil {
      this.x = x;
      this.y = y;
    }

    func opEquals(this, other as Point) -> bool {
      if (this.x != other.x) { return false; }
      if (this.y != other.y) { return false; }
      return true;
    }

    func opCmp(this, other as Point) -> i64 {
      if (this.x < other.x) { return -1; }
      if (this.x > other.x) { return 1; }
      if (this.y < other.y) { return -1; }
      if (this.y > other.y) { return 1; }
      return 0;
    }
}

export func main() -> i64 {
    let p1 = Point(1, 2);
    let p2 = Point(1, 2);
    let p3 = Point(3, 4);

    // Test opEquals via == and !=
    io.println(1, string(p1 == p2));   // true
    io.println(1, string(p1 != p3));   // true
    io.println(1, string(p1 == p3));   // false

    // Test opCmp via <, <=, >, >=
    io.println(1, string(p1 < p3));    // true (1 < 3)
    io.println(1, string(p1 <= p2));   // true (1 == 1, 2 <= 2)
    io.println(1, string(p3 > p1));    // true (3 > 1)
    io.println(1, string(p2 >= p1));   // true (1 >= 1, 2 >= 2)

    drop p1;
    drop p2;
    drop p3;
    return 0;
}
