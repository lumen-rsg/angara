// Test LLVM backend with IO intrinsics
attach io;

export func main() -> i64 {
    io.println(1, "Hello from LLVM!");
    io.println(1, "Testing arithmetic:");
    let x = 3 + 4;
    io.println(1, "3 + 4 = " + string(x));

    io.println(1, "Testing strings:");
    let s = "world";
    io.println(1, "Hello, " + s);

    return 0;
}
