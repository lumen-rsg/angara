attach amqp;
attach io;
attach time;
attach adv_string;

const QUEUE_NAME as string = "angara_task_queue";

// --- The WORKER Logic ---
func run_worker() -> nil {
  io.println(1, "--- Starting WORKER ---");
  let conn = amqp.connect("amqp://guest:guest@localhost:5672/");
  let ch = conn.channel();

  ch.queue_declare(QUEUE_NAME, true, false, false);
  ch.subscribe(QUEUE_NAME);
  io.println(1, "[*] Waiting for messages in queue '" + QUEUE_NAME + "'.");

  while (true) {
    let msg_data as record? = ch.next_message(10);

    if (let received_record = msg_data) {
      @unsafe {
        let msg as {body: string, delivery_tag: i64} = received_record;
        io.println(1, msg["body"]);

        let i as i64 = 0;
        while (i < len(msg["body"])) {
          if (adv_string.get(msg["body"], i) == ".") {
            time.sleep(1.0);
          }
          i = i + 1;
        }

        io.println(1, " [x] Done. Acknowledging message.");
        ch.ack(msg["delivery_tag"]);
      }
    }
  }

  ch.close();
  conn.close();
  drop ch;
  drop conn;
}

// --- The PUBLISHER Logic ---
func run_publisher(message as string) -> nil {
  io.println(1, "--- Starting PUBLISHER ---");
  let conn = amqp.connect("amqp://guest:guest@localhost:5672/");
  let ch = conn.channel();

  ch.queue_declare(QUEUE_NAME, true, false, false);
  ch.publish("", QUEUE_NAME, message);
  io.println(1, " [x] Sent '" + message + "'");

  ch.close();
  conn.close();
  drop ch;
  drop conn;
}

export func main(args as list<string>) -> i64 {
  try {
    if (len(args) > 1) {
      run_publisher(args[1]);
    } else {
      run_publisher("Hello, AMQP!");
    }
  } catch (e) {
    io.println(2, "[FATAL] AMQP Error: " + string(e));
    return 1;
  }
  io.println(1, "\n--- All AMQP tests passed! ---");
  return 0;
}
