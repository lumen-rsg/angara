// archive_test.an — tests for the `archive` module (tar create/extract).
attach archive;
attach fs;
attach io;

func verify_directory(dir_path as string, expected_files as list<string>, absent_files as list<string>) -> bool {
  let all_ok as bool = true;
  for (file in expected_files) {
    let full_path as string = dir_path + "/" + file;
    if (!fs.exists(full_path)) {
      io.println(2, "  [FAIL] Expected file does not exist: " + full_path);
      all_ok = false;
    }
  }
  for (file in absent_files) {
    let full_path as string = dir_path + "/" + file;
    if (fs.exists(full_path)) {
      io.println(2, "  [FAIL] Unexpected file exists: " + full_path);
      all_ok = false;
    }
  }
  if (all_ok) {
    io.println(1, "  [PASS] Directory contents are correct.");
  }
  return all_ok;
}

export func main() -> i64 {
  io.println(1, "--- Angara `archive` Module Test Suite ---");

  const ARCHIVE_NAME as string = "test_archive.tar";
  const SRC_DIR as string = "source_files";
  const EXTRACT_DIR as string = "extracted";

  try {
    fs.create_dir(SRC_DIR);
    fs.create_dir(EXTRACT_DIR);
    fs.write_file(SRC_DIR + "/readme.txt", "This is the readme.");
    fs.write_file(SRC_DIR + "/data.bin", "core binary data");
  } catch (e as Exception) {
    io.println(2, "Setup failed: " + e.message);
    return 1;
  }

  // Test 1: Create a tar archive
  io.println(1, "\n1. Testing archive.tar_create...");
  try {
    let files as list<string> = [
      SRC_DIR + "/readme.txt",
      SRC_DIR + "/data.bin"
    ];
    archive.tar_create(ARCHIVE_NAME, files);
    io.println(1, "  tar_create executed successfully.");
  } catch (e as Exception) {
    io.println(2, "  tar_create failed: " + e.message);
    return 1;
  }

  // Test 2: Extract and verify
  io.println(1, "\n2. Testing archive.tar_extract...");
  try {
    archive.tar_extract(ARCHIVE_NAME, EXTRACT_DIR);
    verify_directory(EXTRACT_DIR, ["readme.txt", "data.bin"], []);
  } catch (e as Exception) {
    io.println(2, "  tar_extract failed: " + e.message);
    return 1;
  }

  // Test 3: gzip roundtrip
  io.println(1, "\n3. Testing archive.gzip_compress / gzip_decompress...");
  try {
    let original = "Hello, compression world!";
    let compressed = archive.gzip_compress(original);
    let decompressed = archive.gzip_decompress(compressed);
    if (decompressed == original) {
      io.println(1, "  [PASS] Gzip roundtrip succeeded.");
    } else {
      io.println(2, "  [FAIL] Gzip roundtrip mismatch.");
      return 1;
    }
  } catch (e as Exception) {
    io.println(2, "  Gzip test failed: " + e.message);
    return 1;
  }

  io.println(1, "\n--- All `archive` module tests passed! ---");
  return 0;
}
