// config_test.an — Angara config module test
// Tests INI, TOML, and dotenv parsing
//
// Usage: angara tests/config_test.an

attach config;
attach io;


export func main() -> i64 {
  io.println(1, "--- Angara Config Module Test ---");

  // --- INI ---
  let ini_text = "[database]\nhost=localhost\nport=5432\nname=mydb\n[server]\nhost=0.0.0.0\nport=8080\n";
  let ini = config.parse_ini(ini_text);
  io.println(1, "INI database.host: " + string(ini["database"]["host"]));
  io.println(1, "INI database.port: " + string(ini["database"]["port"]));
  io.println(1, "INI server.port: " + string(ini["server"]["port"]));

  // Stringify back
  let ini_out = config.stringify_ini(ini);
  println("INI roundtrip length: " + string(ini_out.length()));

  // --- TOML ---
  let toml_text = "[owner]\nname = \"Alice\"\nage = 30\nactive = true\n\n[server]\nhost = \"127.0.0.1\"\nport = 9090\n";
  let toml = config.parse_toml(toml_text);
  io.println(1, "TOML owner.name: " + string(toml["owner"]["name"]));
  io.println(1, "TOML owner.age: " + string(toml["owner"]["age"]));
  io.println(1, "TOML owner.active: " + string(toml["owner"]["active"]));
  io.println(1, "TOML server.port: " + string(toml["server"]["port"]));

  // --- Dotenv ---
  let env_text = "# Database config\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=\"my database\"\nexport DB_USER=admin\n";
  let env = config.parse_dotenv(env_text);
  io.println(1, "DOTENV DB_HOST: " + string(env["DB_HOST"]));
  io.println(1, "DOTENV DB_PORT: " + string(env["DB_PORT"]));
  io.println(1, "DOTENV DB_NAME: " + string(env["DB_NAME"]));
  io.println(1, "DOTENV DB_USER: " + string(env["DB_USER"]));

  // Stringify dotenv
  let env_out = config.stringify_dotenv(env);
  println("DOTENV roundtrip length: " + string(env_out.length()));

  // Verify roundtrip
  let env2 = config.parse_dotenv(env_out);
  if (env2["DB_HOST"] == "localhost") {
    io.println(1, "\n--- All config tests passed! ---");
    return 0;
  }
  io.println(1, "\n--- Config tests FAILED ---");
  return 1;
}