attach io;


func main() -> i64 {
  io.println(1, "--- Angara IO Module Test ---");

  const STDOUT = 1;
  const STDERR = 2;

  // 1. Test writing to stdout and stderr
  io.write(STDOUT, "This is a message to standard output.\n");
  io.write(STDERR, "This is an error message to standard error.\n");
  io.write(STDOUT, "This line is not flushed yet...");

  // 2. Test flushing
  try {
    io.flush(STDOUT);
    io.println(1, " (OK, now it is.)");
  } catch (e) {
    io.println(1, "Error flushing stream: " + string(e));
  }

  // 3. Test reading a single line
  io.write(STDOUT, "\nPlease enter your name: ");
  io.flush(STDOUT);

  let name = io.read_line();

  if (name == nil) {
    io.println(1, "\nNo input received (EOF).");
  } else {
    // This is the line that was failing. It will now work correctly.
    io.println(1, "\nHello, " + name + "!");
  }

  // 4. Test read_all()
  io.println(1, "\n--- Testing read_all() ---");
  io.println(1, "Reading all of stdin. Use a pipe to test.");
  let all_input = io.read_all();
  if (all_input == "") {
    io.println(1, "stdin was empty.");
  } else {
    io.println(1, "Received from stdin:\n---\n" + all_input + "\n---");
  }

  return 0;
}