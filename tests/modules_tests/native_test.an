// --- Test for Attaching Native C ABI Modules ---
// Tests loading a native .so module and calling its functions.
attach fs;
attach io;

export func main() -> i64 {
  io.println(1, "--- Testing Native Module Attachment ---");

  // Call the native function imported from the fs module.
  let content = fs.read_file("data.txt");

  if (content == nil) {
    io.println(2, "  [FAIL] Could not read data.txt");
    return 1;
  }

  io.println(1, "  [PASS] Read file content: " + string(content));

  // Test write_file
  fs.write_file("output.txt", "Hello from Angara!");
  io.println(1, "  [PASS] Wrote output.txt");

  // Test exists
  if (fs.exists("output.txt")) {
    io.println(1, "  [PASS] output.txt exists");
  } else {
    io.println(2, "  [FAIL] output.txt does not exist");
    return 1;
  }

  io.println(1, "\n--- All native module tests passed! ---");
  return 0;
}
