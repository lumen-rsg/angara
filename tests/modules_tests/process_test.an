// process_test.an — Angara process module test
// Usage: angara tests/process_test.an

attach process;
attach io;


export func main() -> i64 {
  io.println(1, "--- Angara Process Module Test ---");

  // Test exec (simple command)
  let output = process.exec("echo 'hello world'");
  io.println(1, "exec echo: '" + string(output) + "'");

  // Test run with captured output
  let result = process.run("ls", ["/tmp"]);
  @unsafe {
    io.println(1, "run ls exit_code: " + string(result["exit_code"]));
    io.println(1, "run ls stdout length: " + string(len(result["stdout"])));
  }

  // Test getpid
  let pid = process.getpid();
  io.println(1, "Current PID: " + string(pid));

  // Test getppid
  let ppid = process.getppid();
  io.println(1, "Parent PID: " + string(ppid));

  // Test spawn with streaming I/O
  let cat = process.spawn("cat", []);
  if (cat != nil) {
    cat.write("hello from spawn\n");
    cat.close_stdin();
    let cat_out = cat.read_stdout(1024);
    io.println(1, "spawn cat output: '" + string(cat_out) + "'");
    let exit_code = cat.wait();
    io.println(1, "spawn cat exit_code: " + string(exit_code));
  }
  drop cat;

  if (process.getpid() > 0) {
    io.println(1, "\n--- All process tests passed! ---");
    return 0;
  }
  io.println(1, "\n--- Process tests FAILED ---");
  return 1;
}