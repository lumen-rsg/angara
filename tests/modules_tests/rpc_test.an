// rpc_test.an — Angara JSON-RPC 2.0 module test
//
// Demonstrates a full RPC round-trip:
//   1. Server listens on a port
//   2. Client calls a method
//   3. Server reads the request, handles it, responds
//   4. Client receives the result
//
// Usage: angara tests/rpc_test.an

attach rpc;
attach io;
attach time;

func println(s as string) -> void {
  io.write(1, s + "\n");
}

// Handler: dispatch JSON-RPC methods
func handle_method(method as string, params as any) -> any {
  if method == "add" {
    // params should be a list [a, b]
    let p as list<i64> = params;
    if p.length() >= 2 {
      return p[0] + p[1];
    }
    return 0;
  }
  if method == "greet" {
    let p as list<string> = params;
    if p.length() >= 1 {
      return "Hello, " + p[0] + "!";
    }
    return "Hello, stranger!";
  }
  if method == "echo" {
    let p as list<any> = params;
    if p.length() >= 1 {
      return p[0];
    }
    return nil;
  }
  return "unknown method: " + method;
}

export func main() -> i64 {
  println("--- Angara JSON-RPC 2.0 Module Test ---");

  const PORT = 19876;

  // 1. Create the RPC server
  let server = rpc.create_server(PORT);
  if server == nil {
    println("FAIL: Could not create RPC server on port " + string(PORT));
    return 1;
  }
  println("Server created on port " + string(PORT));

  // 2. Spawn a client in a separate thread
  let client_thread = spawn(func() -> i64 {
    time.sleep(0.2);  // Give server a moment to be ready

    println("[CLIENT] Calling rpc.call('add', [10, 20])...");
    try {
      let result = rpc.call("localhost", PORT, "add", [10, 20]);
      println("[CLIENT] Result: " + string(result));
      if result as i64 == 30 {
        println("[CLIENT] PASS: add(10, 20) = 30");
      } else {
        println("[CLIENT] FAIL: expected 30, got " + string(result));
        return 1;
      }
    } catch (e) {
      println("[CLIENT] FAIL: exception: " + string(e));
      return 1;
    }

    // Test string result
    try {
      let greet_result = rpc.call("localhost", PORT, "greet", ["World"]);
      println("[CLIENT] Greet result: " + string(greet_result));
    } catch (e) {
      println("[CLIENT] FAIL: greet exception: " + string(e));
      return 1;
    }

    // Test notification (no response expected)
    rpc.notify("localhost", PORT, "log", ["test notification"]);
    println("[CLIENT] Notification sent.");

    return 0;
  });

  // 3. Server event loop — handle 3 requests (add, greet, notify)
  let handled = 0;
  let max_requests = 3;
  let client_result = 0;

  while handled < max_requests {
    // Accept new connections
    let clients = server.poll_clients();

    // Try to read from each new client
    let i = 0;
    while i < clients.length() {
      let client_fd = clients[i];
      let req = server.read_request(client_fd);
      if req != nil {
        let req_method as string = req["method"];
        let req_id = req["id"];
        let req_params = req["params"];
        let req_fd as i64 = req["client_fd"];

        println("[SERVER] Request: method=" + req_method + " id=" + string(req_id));

        // Only respond if there's an id (not a notification)
        if req_id != nil {
          let result = handle_method(req_method, req_params);
          server.respond(req_id, result, req_fd);
          println("[SERVER] Responded with: " + string(result));
        } else {
          println("[SERVER] Notification received (no response needed).");
        }
        handled = handled + 1;
      }
      i = i + 1;
    }

    time.sleep(0.05);
  }

  // 4. Wait for client thread
  client_result = client_thread.join();
  println("[MAIN] Client thread result: " + string(client_result));

  // 5. Clean up
  server.close();
  println("[MAIN] Server closed.");

  if client_result == 0 {
    println("\n--- All RPC tests passed! ---");
  } else {
    println("\n--- Some RPC tests FAILED ---");
  }

  return client_result;
}