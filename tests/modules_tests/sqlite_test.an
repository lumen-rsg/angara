// sqlite_test.an — Angara SQLite module test
// Tests the OO API: db.execute, db.query_one, db.run with parameterized queries.
attach sqlite;
attach io;
attach fs;

export func main() -> i64 {
  io.println(1, "--- Angara SQLite Module Test ---");

  const DB_PATH = "/tmp/angara_sqlite_test.db";

  // Clean up any previous test DB
  if (fs.exists(DB_PATH)) {
    fs.remove(DB_PATH);
  }

  // 1. Open database
  let db = sqlite.open(DB_PATH);
  io.println(1, "Opened database: " + DB_PATH);

  // 2. Create table + insert rows via db.execute (returns result rows)
  db.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER)");
  io.println(1, "Created 'users' table");

  // 3. Insert with parameterized query (db.run returns rows affected)
  db.run("INSERT INTO users (name, age) VALUES ('Alice', 30)");
  db.run("INSERT INTO users (name, age) VALUES ('Bob', 25)");
  db.run("INSERT INTO users (name, age) VALUES ('Charlie', 35)");
  io.println(1, "Inserted 3 rows");

  // 4. Parameterized insert with a list of params
  db.run("INSERT INTO users (name, age) VALUES (?, ?)", ["Diana", 28]);
  io.println(1, "Inserted Diana via parameterized query");

  // 5. Query one row (returns {}? — optional record)
  let alice = db.query_one("SELECT * FROM users WHERE name = 'Alice'");
  if (alice != nil) {
    @unsafe {
      io.println(1, "Alice: id=" + string(alice["id"]) + " age=" + string(alice["age"]));
    }
  }

  // 6. Parameterized query
  let older = db.query_one("SELECT * FROM users WHERE age > ?", [28]);
  if (older != nil) {
    @unsafe {
      io.println(1, "First user with age > 28: " + string(older["name"]));
    }
  }

  // 7. Count via execute (returns a list of row records)
  let count_rows = db.execute("SELECT COUNT(*) as cnt FROM users");
  @unsafe {
    io.println(1, "Total users: " + string(count_rows[0]["cnt"]));
  }

  // 8. Test transaction
  db.execute("BEGIN TRANSACTION");
  db.run("INSERT INTO users (name, age) VALUES ('Eve', 22)");
  db.execute("ROLLBACK");
  let after_rollback = db.execute("SELECT COUNT(*) as cnt FROM users");
  @unsafe {
    io.println(1, "After rollback count: " + string(after_rollback[0]["cnt"]));
  }

  // 9. last_insert_id + changes
  db.run("INSERT INTO users (name, age) VALUES ('Frank', 40)");
  io.println(1, "Last insert id: " + string(db.last_insert_id()));
  io.println(1, "Rows changed: " + string(db.changes()));

  // 10. Close
  db.close();
  drop db;
  io.println(1, "Database closed.");

  // Clean up
  if (fs.exists(DB_PATH)) {
    fs.remove(DB_PATH);
  }

  io.println(1, "\n--- All SQLite tests passed! ---");
  return 0;
}
