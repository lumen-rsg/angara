// term_test.an — Angara term module test
// Tests the current terminal module API: size, colors, cursor, styles.
attach term;
attach io;

export func main() -> i64 {
  io.println(1, "--- Angara Term Module Test ---");

  // 1. Terminal size — returns {rows, cols} record
  let size = term.terminal_size();
  @unsafe {
    io.println(1, "Terminal size: " + string(size["cols"]) + "x" + string(size["rows"]));
  }

  // 2. Check if stdout is a terminal
  let tty = term.is_tty(1);
  io.println(1, "stdout is TTY: " + string(tty));

  // 3. Colored output via colorize(text, fg, bg?)
  let red_text = term.colorize("red text", "31", "0");
  let green_text = term.colorize("green text", "32");
  io.println(1, "Colors: " + red_text + " " + green_text);

  // 4. Styled output (bold/dim/underline return ANSI-wrapped strings)
  io.println(1, "Styles: " + term.bold("bold") + " " + term.dim("dim") + " " + term.underline("underline"));

  // 5. Reset color
  term.reset_color();
  io.println(1, "Color reset executed.");

  // 6. Clear screen + clear line (just verify no crash)
  term.clear();
  term.clear_line();
  io.println(1, "Clear operations executed.");

  // 7. Cursor operations
  term.cursor_move(10, 5);
  term.cursor_up(2);
  term.cursor_down(2);
  term.cursor_move(1, 1);
  io.println(1, "Cursor operations executed.");

  // 8. Show/hide cursor
  term.hide_cursor();
  term.show_cursor();
  io.println(1, "Cursor show/hide executed.");

  // 9. Progress bar
  let bar = term.progress_bar(0.75, 1.0, 40);
  io.println(1, "Progress bar: " + bar);

  io.println(1, "\n--- All term tests passed! ---");
  return 0;
}
