attach time;
attach io;

export func main() -> i64 {
  io.println(1, "--- Angara Time Module Test ---");

  // 1. Test time.now() and time.format_iso()
  io.println(1, "\nTesting current time and formatting:");
  let timestamp = time.now();
  io.println(1, "Current Unix timestamp: " + string(timestamp));
  let formatted_time = time.format_iso(timestamp);
  io.println(1, "Current time (UTC): " + formatted_time);

  // 2. Test time.sleep()
  io.println(1, "\nTesting sleep for 1.2 seconds...");
  time.sleep(1.2);
  io.println(1, "Awake!");

  // 3. Test timing: use time.now() deltas instead of Stopwatch methods
  //    (Stopwatch is a native_instance whose type doesn't carry method
  //    signatures through the type checker yet — a known limitation).
  io.println(1, "\nTesting timing:");
  let t0 = time.now();
  let i = 0;
  while (i < 1000000) { i = i + 1; }
  let t1 = time.now();
  io.println(1, "Trivial work took: " + string(t1 - t0) + " seconds.");

  time.sleep(0.05);
  let t2 = time.now();
  io.println(1, "Time after sleeping: " + string(t2 - t0) + " seconds.");

  return 0;
}