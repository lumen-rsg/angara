// process_test.an — Angara process module test
// Usage: angara tests/process_test.an

attach process;
attach io;

func println(s as string) -> void {
  io.write(1, s + "\n");
}

export func main() -> i64 {
  println("--- Angara Process Module Test ---");

  // Test exec (simple command)
  let output = process.exec("echo 'hello world'");
  println("exec echo: '" + string(output).trim() + "'");

  // Test run with captured output
  let result = process.run("ls", ["/tmp"]);
  println("run ls exit_code: " + string(result["exit_code"]));
  println("run ls stdout length: " + string(result["stdout"].length()));

  // Test getpid
  let pid = process.getpid();
  println("Current PID: " + string(pid));

  // Test getppid
  let ppid = process.getppid();
  println("Parent PID: " + string(ppid));

  // Test spawn with streaming I/O
  let cat = process.spawn("cat", []);
  if cat != nil {
    cat.write("hello from spawn\n");
    cat.close_stdin();
    let cat_out = cat.read_stdout(1024);
    println("spawn cat output: '" + string(cat_out).trim() + "'");
    let exit_code = cat.wait();
    println("spawn cat exit_code: " + string(exit_code));
  }

  if process.getpid() > 0 {
    println("\n--- All process tests passed! ---");
    return 0;
  }
  println("\n--- Process tests FAILED ---");
  return 1;
}