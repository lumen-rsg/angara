attach io;

// ============================================================================
// Angara LLVM Backend — Comprehensive Stress Test
// ============================================================================

// --- Helper functions ---
func fibonacci(n as i64) -> i64 {
    if (n <= 1) { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

func is_prime(n as i64) -> bool {
    if (n < 2) { return false; }
    let i = 2;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        i = i + 1;
    }
    return true;
}

func count_primes(limit as i64) -> i64 {
    let count = 0;
    let n = 2;
    while (n < limit) {
        if (is_prime(n)) {
            count = count + 1;
        }
        n = n + 1;
    }
    return count;
}

func factorial(n as i64) -> i64 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

// --- Enum ---
enum Color {
    Red,
    Green,
    Blue
}

// --- Class ---
class Counter {
  public:
    let count as i64;

  public:
    func init(this, start as i64) -> nil {
        this.count = start;
    }

    func increment(this) -> i64 {
        this.count = this.count + 1;
        return this.count;
    }

    func get_count(this) -> i64 {
        return this.count;
    }
}

// ============================================================================
export func main() -> i64 {
    io.println(1, "========================================");
    io.println(1, "  Angara LLVM Backend — Stress Test");
    io.println(1, "========================================");
    io.println(1, "");

    // === Section 1: Primitives & Arithmetic ===
    io.println(1, "--- Primitives & Arithmetic ---");
    let a = 10;
    let b = 3;
    io.println(1, "10 + 3 = " + string(a + b));         // 13
    io.println(1, "10 - 3 = " + string(a - b));         // 7
    io.println(1, "10 * 3 = " + string(a * b));         // 30
    io.println(1, "10 / 3 = " + string(a / b));         // 3
    io.println(1, "10 % 3 = " + string(a % b));         // 1
    let neg = -5;
    io.println(1, "neg(-5) = " + string(neg));          // -5
    io.println(1, "PASS: Primitives & Arithmetic");
    io.println(1, "");

    // === Section 2: Comparisons & Booleans ===
    io.println(1, "--- Comparisons & Booleans ---");
    if (10 > 5) { io.println(1, "10 > 5: true"); }
    if (3 < 10) { io.println(1, "3 < 10: true"); }
    if (5 >= 5) { io.println(1, "5 >= 5: true"); }
    if (4 <= 4) { io.println(1, "4 <= 4: true"); }
    if (5 == 5) { io.println(1, "5 == 5: true"); }
    if (5 != 6) { io.println(1, "5 != 6: true"); }
    let t = true;
    let f = false;
    if (t && !f) { io.println(1, "true && !false: true"); }
    if (t || f) { io.println(1, "true || false: true"); }
    if (!f) { io.println(1, "!false: true"); }
    io.println(1, "PASS: Comparisons & Booleans");
    io.println(1, "");

    // === Section 3: Strings ===
    io.println(1, "--- Strings ---");
    let hello = "Hello";
    let world = "World";
    let greeting = hello + ", " + world + "!";
    io.println(1, "Greeting: " + greeting);
    io.println(1, "string(42) = " + string(42));
    io.println(1, "string(0) = " + string(0));
    io.println(1, "string(-7) = " + string(-7));
    io.println(1, "PASS: Strings");
    io.println(1, "");

    // === Section 4: Control Flow ===
    io.println(1, "--- Control Flow ---");

    // if/else chain
    let x = 42;
    if (x > 100) {
        io.println(1, "big");
    } else if (x > 10) {
        io.println(1, "medium");  // this one
    } else {
        io.println(1, "small");
    }

    // while loop
    let wsum = 0;
    let wi = 1;
    while (wi <= 10) {
        wsum = wsum + wi;
        wi = wi + 1;
    }
    io.println(1, "1+2+...+10 = " + string(wsum));  // 55

    // for loop
    let fprod = 1;
    for (let fi = 1; fi <= 6; fi = fi + 1) {
        fprod = fprod * fi;
    }
    io.println(1, "6! = " + string(fprod));  // 720

    // for-in
    let nums = [10, 20, 30, 40, 50];
    let fsum = 0;
    for (n in nums) {
        fsum = fsum + n;
    }
    io.println(1, "Sum of [10..50] = " + string(fsum));  // 150

    io.println(1, "PASS: Control Flow");
    io.println(1, "");

    // === Section 5: Functions & Recursion ===
    io.println(1, "--- Functions & Recursion ---");
    io.println(1, "fib(10) = " + string(fibonacci(10))); // 55
    io.println(1, "10! = " + string(factorial(10)));      // 3628800
    io.println(1, "PASS: Functions & Recursion");
    io.println(1, "");

    // === Section 6: Records ===
    io.println(1, "--- Records ---");
    let person = { name: "Alice", age: 30 };
    io.println(1, "name: " + person["name"]);
    io.println(1, "age: " + string(person["age"]));
    person["age"] = 31;
    io.println(1, "updated age = " + string(person["age"]));
    io.println(1, "PASS: Records");
    io.println(1, "");

    // === Section 7: Exceptions ===
    io.println(1, "--- Exceptions ---");
    try {
        io.println(1, "in try block");
    } catch (e as Exception) {
        io.println(1, "should not catch");
    }
    io.println(1, "after try/catch");
    io.println(1, "PASS: Exceptions");
    io.println(1, "");

    // === Section 8: Stress Compute ===
    io.println(1, "--- Stress: Compute ---");
    io.println(1, "Primes < 100: " + string(count_primes(100)));   // 25
    io.println(1, "fib(20) = " + string(fibonacci(20)));           // 6765
    io.println(1, "PASS: Stress Compute");
    io.println(1, "");

    // === Final ===
    io.println(1, "========================================");
    io.println(1, "  ALL STRESS TESTS PASSED");
    io.println(1, "========================================");
    return 0;
}
