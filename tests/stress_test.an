attach io;
attach assert;

// --- 1. Data Structures for Matrix Math (Memory/CPU Stress) ---
data Vector3 {
    let x as i64;
    let y as i64;
    let z as i64;
}

// --- 2. Enum for State Machine (Match/Logic Stress) ---
enum ProcessState {
    Idle,
    Running(i64), // Progress 0-100
    Error(string),
    Done
}

// --- 3. Class for Shared State (Concurrency Stress) ---
class SharedCounter {
    public:
    let value as i64;
    let mtx as Mutex;

    func init() {
        this.value = 0;
        this.mtx = Mutex();
    }

    func increment() {
        this.mtx.lock();
        // verbose read/write to force race conditions if lock fails
        let temp = this.value;
        this.value = temp + 1;
        this.mtx.unlock();
    }
}

// --- TEST 1: Recursion (Stack Stress) ---
func fib(n as i64) -> i64 {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

func test_recursion() {
    io.println(1, "[Stress] Recursion (Fibonacci)...");
    // fib(25) ~ 121393 calls. Good test of stack frames and integer boxing.
    let res = fib(25);
    assert.eq(res, 75025, "Fibonacci(25) calculation");
}

// --- TEST 2: Object Churn & Vector Math (Heap Stress) ---
func test_vector_math() {
    io.println(1, "[Stress] Vector Allocation (100k objects)...");

    let result = Vector3(0, 0, 0);

    // Loop 100,000 times.
    // This creates and destroys temporary Data objects rapidly.
    // If ref-counting is broken, memory usage will explode.
    for (let i = 0; i < 100000; i++) {
        let v1 = Vector3(1, 2, 3);
        let v2 = Vector3(4, 5, 6);

        // Manual vector addition (simulated)
        let sum = Vector3(v1.x + v2.x, v1.y + v2.y, v1.z + v2.z);

        // Accumulate into result
        // Note: Data is immutable-ish in this context, we are replacing the var
        result = Vector3(result.x + 1, result.y + 1, result.z + 1);
    }

    assert.eq(result.x, 100000, "Vector accumulation X");
}

// --- TEST 3: Pattern Matching (Logic Stress) ---
func process_logic(state as ProcessState) -> string {
    match (state) {
        case ProcessState.Idle: return "Waiting";
        case ProcessState.Running(p): {
            if (p < 50) return "Starting";
            return "Finishing";
        }
        case ProcessState.Error(msg): return "Failed: " + msg;
        case ProcessState.Done: return "Success";
        case _: return "Unknown";
    }
}

func test_enums() {
    io.println(1, "[Stress] Enum Pattern Matching...");

    assert.eq(process_logic(ProcessState.Idle), "Waiting", "Enum Idle");
    assert.eq(process_logic(ProcessState.Running(10)), "Starting", "Enum Running Low");
    assert.eq(process_logic(ProcessState.Running(90)), "Finishing", "Enum Running High");
    assert.eq(process_logic(ProcessState.Error("Timeout")), "Failed: Timeout", "Enum Error");

    // Test Equality on Enums
    let e1 = ProcessState.Running(50);
    let e2 = ProcessState.Running(50);
    let e3 = ProcessState.Running(51);

    assert.eq(e1, e2, "Enum Structural Equality");
    assert.ne(e1, e3, "Enum Structural Inequality");
}

// --- TEST 4: Concurrency (Thread Stress) ---

// This is the function run by threads.
// Since we don't have lambdas, we use a named function.
func worker_task(counter as SharedCounter, iterations as i64) {
    for (let i = 0; i < iterations; i++) {
        counter.increment();
    }
}

func test_concurrency() {
    io.println(1, "[Stress] Threads & Mutexes...");

    let counter = SharedCounter();
    let threads = []; // list<Thread>
    let num_threads = 5;
    let ops_per_thread = 1000;

    // Spawn threads
    for (let i = 0; i < num_threads; i++) {
        // Passing 'worker_task' by name (function pointer)
        let t = spawn(worker_task, counter, ops_per_thread);
        threads.push(t);
    }

    // Join threads
    for (let i = 0; i < num_threads; i++) {
        threads[i].join();
    }

    let expected = num_threads * ops_per_thread;
    assert.eq(counter.value, expected, "Threaded counter value");
}

// --- TEST 5: List & Record Nesting (Deep Equality Stress) ---
func test_deep_structures() {
    io.println(1, "[Stress] Deep Structure Comparison...");

    let complex_1 = {
        "users": [
            { "id": 1, "tags": ["admin", "staff"] },
            { "id": 2, "tags": ["guest"] }
        ],
        "meta": Vector3(10, 20, 30)
    };

    // Clone manually to ensure distinct memory
    let complex_2 = {
        "users": [
            { "id": 1, "tags": ["admin", "staff"] },
            { "id": 2, "tags": ["guest"] }
        ],
        "meta": Vector3(10, 20, 30)
    };

    let complex_3 = complex_1.clone(); // Deep clone of record

    assert.eq(complex_1, complex_2, "Structural Equality (Manual)");
    assert.eq(complex_1, complex_3, "Structural Equality (Cloned)");

    // Modify clone
    complex_3["users"][0]["tags"].push("banned");

    assert.ne(complex_1, complex_3, "Independence after modification");
}

export func main() -> i64 {
    try {
        io.println(1, "=== BEGIN STRESS TEST ===");

        test_recursion();
        test_vector_math();
        test_enums();
        test_deep_structures();
        test_concurrency();

        io.println(1, "\n=== ALL SYSTEMS NOMINAL ===");
        return 0;
    } catch (e as Exception) {
        io.println(2, "\n[CRITICAL FAILURE]");
        io.println(2, e.message);
        return 1;
    }
}