attach io;
attach collections;

func double_item(x as any) -> any { return x * 2; }
func is_even(x as any) -> any { return x % 2 == 0; }
func add_em(acc as any, x as any) -> any { return acc + x; }
func is_big(x as any) -> any { return x > 30; }
func is_huge(x as any) -> any { return x > 40; }
func is_positive(x as any) -> any { return x > 0; }
func print_word(x as any) -> any { io.println(1, "item: " + x); return nil; }

export func main() -> i64 {
    let nums as list<any> = [10, 20, 30, 40, 50];
    let words as list<any> = ["hello", "world", "angara"];

    // --- Transformers ---
    let doubled = collections.map(double_item, nums);
    io.println(1, "doubled: " + collections.join(doubled, ", "));

    let evens = collections.filter(is_even, nums);
    io.println(1, "evens: " + collections.join(evens, ", "));

    let sum = collections.reduce(add_em, 0, nums);
    io.println(1, "sum: " + sum);

    // --- Predicates ---
    let has_big = collections.find(is_big, nums);
    io.println(1, "has >30: " + has_big);

    let any_big = collections.any(is_huge, nums);
    io.println(1, "any >40: " + any_big);

    let all_pos = collections.all(is_positive, nums);
    io.println(1, "all >0: " + all_pos);

    let has30 = collections.contains(30, nums);
    io.println(1, "contains 30: " + has30);

    let count = collections.count(nums);
    io.println(1, "count: " + count);

    // --- Ordering & Slicing ---
    let rev = collections.reverse(nums);
    io.println(1, "reversed: " + collections.join(rev, ", "));

    let extra as list<any> = [60, 70];
    let combined = collections.concat(nums, extra);
    io.println(1, "concat: " + collections.join(combined, ", "));

    let first3 = collections.take(nums, 3);
    io.println(1, "take 3: " + collections.join(first3, ", "));

    let skipped = collections.skip(nums, 2);
    io.println(1, "skip 2: " + collections.join(skipped, ", "));

    let f = collections.first(nums);
    io.println(1, "first: " + f);

    let l = collections.last(nums);
    io.println(1, "last: " + l);

    // --- isEmpty ---
    let empty as list<any> = [];
    io.println(1, "empty is_empty: " + collections.is_empty(empty));
    io.println(1, "nums is_empty: " + collections.is_empty(nums));

    // --- for_each ---
    collections.for_each(print_word, words);

    // --- join & chars ---
    io.println(1, "joined: " + collections.join(words, " - "));
    let chars = collections.chars("ABC");
    io.println(1, "chars: " + collections.join(chars, "|"));

    return 0;
}