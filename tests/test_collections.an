attach io;
attach collections;

// Angara Collections Test — C#-styled API + LINQ higher-order functions
export func main() -> i64 {
    // ============================================================
    // BASIC OPERATIONS (non-lambda)
    // ============================================================
    let r = collections.Range(1, 5);
    io.println(1, "Range count: " + string(collections.Count(r)));
    io.println(1, "Range first: " + string(collections.First(r)));
    io.println(1, "Range last: " + string(collections.Last(r)));

    let nums = [10, 20, 30, 40, 50];
    let rev = collections.Reverse(nums);
    io.println(1, "Reverse first: " + string(collections.First(rev)));
    io.println(1, "Reverse last: " + string(collections.Last(rev)));

    let t = collections.Take(nums, 3);
    io.println(1, "Take(3) count: " + string(collections.Count(t)));

    let s = collections.Skip(nums, 2);
    io.println(1, "Skip(2) count: " + string(collections.Count(s)));

    let dupes = [1, 1, 2, 2, 3, 3, 3];
    io.println(1, "Distinct count: " + string(collections.Count(collections.Distinct(dupes))));

    let c = collections.Concat([1, 2], [3, 4]);
    io.println(1, "Concat count: " + string(collections.Count(c)));

    io.println(1, "Contains 30: " + string(collections.Contains(nums, 30)));
    io.println(1, "Contains 99: " + string(collections.Contains(nums, 99)));
    io.println(1, "Join: " + collections.Join(nums, ", "));

    // Set operations
    let a = [1, 2, 3, 4];
    let b = [3, 4, 5, 6];
    io.println(1, "Except count: " + string(collections.Count(collections.Except(a, b))));
    io.println(1, "Intersect count: " + string(collections.Count(collections.Intersect(a, b))));
    io.println(1, "Union count: " + string(collections.Count(collections.Union(a, b))));

    // Predicates (non-lambda)
    io.println(1, "IsEmpty([1,2]): " + string(collections.IsEmpty([1, 2])));
    io.println(1, "Any([1,2]): " + string(collections.Any([1, 2])));
    io.println(1, "SequenceEqual: " + string(collections.SequenceEqual([1, 2], [1, 2])));

    // Numeric aggregates
    io.println(1, "Sum: " + string(collections.Sum([1, 2, 3, 4, 5])));
    io.println(1, "Min: " + string(collections.Min([5, 3, 8, 1, 9])));
    io.println(1, "Max: " + string(collections.Max([5, 3, 8, 1, 9])));
    io.println(1, "Average: " + string(collections.Average([10, 20, 30])));

    // ============================================================
    // HIGHER-ORDER FUNCTIONS (LINQ with lambdas)
    // ============================================================
    io.println(1, "--- LINQ with Lambdas ---");

    // Select — map each element
    let doubled = collections.Select([1, 2, 3, 4, 5],
        func(x as any) -> any { @unsafe { return x * 2; } });
    io.println(1, "Select (x*2): " + collections.Join(doubled, ", "));

    // Where — filter elements
    let evens = collections.Where([1, 2, 3, 4, 5, 6],
        func(x as any) -> any { @unsafe { return x % 2 == 0; } });
    io.println(1, "Where (even): " + collections.Join(evens, ", "));

    // Aggregate — reduce with seed
    let total = collections.Aggregate([1, 2, 3, 4, 5], 0,
        func(acc as any, x as any) -> any { @unsafe { return acc + x; } });
    io.println(1, "Aggregate (sum): " + string(total));

    // AnyMatch — any element satisfies predicate
    let hasBig = collections.AnyMatch([1, 5, 10, 3],
        func(x as any) -> any { @unsafe { return x > 8; } });
    io.println(1, "AnyMatch (>8): " + string(hasBig));

    // All — all elements satisfy predicate
    let allPositive = collections.All([1, 2, 3, 4],
        func(x as any) -> any { @unsafe { return x > 0; } });
    io.println(1, "All (>0): " + string(allPositive));

    // CountMatch — count matching elements
    let evenCount = collections.CountMatch([1, 2, 3, 4, 5, 6],
        func(x as any) -> any { @unsafe { return x % 2 == 0; } });
    io.println(1, "CountMatch (even): " + string(evenCount));

    // FirstMatch — first element matching predicate
    let firstBig = collections.FirstMatch([1, 3, 7, 2, 9],
        func(x as any) -> any { @unsafe { return x > 5; } });
    io.println(1, "FirstMatch (>5): " + string(firstBig));

    // LastMatch — last element matching predicate
    let lastBig = collections.LastMatch([1, 3, 7, 2, 9],
        func(x as any) -> any { @unsafe { return x > 5; } });
    io.println(1, "LastMatch (>5): " + string(lastBig));

    // SortBy — sort with comparator
    let sorted = collections.SortBy([5, 2, 8, 1, 9, 3],
        func(a as any, b as any) -> any { @unsafe { return a < b; } });
    io.println(1, "SortBy (asc): " + collections.Join(sorted, ", "));

    // ForEach — execute action for each element
    collections.ForEach([100, 200, 300],
        func(x as any) -> any { io.println(1, "ForEach item: " + string(x)); return nil; });

    // ============================================================
    // STRING-SPECIFIC OPERATIONS
    // ============================================================
    io.println(1, "--- String Operations ---");

    let words = ["cherry", "apple", "banana", "date"];
    io.println(1, "MinString: " + collections.MinString(words));
    io.println(1, "MaxString: " + collections.MaxString(words));
    io.println(1, "Longest: " + collections.Longest(words));
    io.println(1, "Shortest: " + collections.Shortest(words));

    // ============================================================
    // BOOLEAN COLLECTION OPERATIONS
    // ============================================================
    io.println(1, "--- Boolean Operations ---");

    let bools = [true, false, true, true];
    io.println(1, "AnyTrue: " + string(collections.AnyTrue(bools)));
    io.println(1, "AllTrue: " + string(collections.AllTrue(bools)));
    io.println(1, "CountTrue: " + string(collections.CountTrue(bools)));

    let allTrueList = [true, true, true];
    io.println(1, "AllTrue (all): " + string(collections.AllTrue(allTrueList)));

    let allFalseList = [false, false];
    io.println(1, "AnyTrue (none): " + string(collections.AnyTrue(allFalseList)));

    // ============================================================
    // TYPE CONVERSION UTILITIES
    // ============================================================
    io.println(1, "--- Type Conversions ---");

    let nums2str = collections.ToStrings([10, 20, 30]);
    io.println(1, "ToStrings: " + collections.Join(nums2str, ", "));

    let mappedStr = collections.MapStrings([1, 2, 3, 4],
        func(x as any) -> any { @unsafe { return x * 10; } });
    io.println(1, "MapStrings (x*10): " + collections.Join(mappedStr, ", "));

    // ============================================================
    // UTILITY FUNCTIONS
    // ============================================================
    io.println(1, "--- Utility Functions ---");

    // Flatten
    let nested = [[1, 2], [3, 4], [5]];
    let flat = collections.Flatten(nested);
    io.println(1, "Flatten: " + collections.Join(flat, ", "));

    // Chunk
    let chunked = collections.Chunk([1, 2, 3, 4, 5], 2);
    io.println(1, "Chunk(2) count: " + string(collections.Count(chunked)));

    // Zip
    let keys = ["a", "b", "c"];
    let vals = [1, 2, 3];
    let zipped = collections.Zip(keys, vals);
    io.println(1, "Zip count: " + string(collections.Count(zipped)));

    // Partition
    let parts = collections.Partition([1, 2, 3, 4, 5, 6],
        func(x as any) -> any { @unsafe { return x % 2 == 0; } });
    io.println(1, "Partition count: " + string(collections.Count(parts)));

    // Indices
    let idx = collections.Indices([10, 20, 30]);
    io.println(1, "Indices: " + collections.Join(idx, ", "));

    // Rotate
    let rotated = collections.Rotate([1, 2, 3, 4, 5], 2);
    io.println(1, "Rotate(2): " + collections.Join(rotated, ", "));
    let rotatedLeft = collections.Rotate([1, 2, 3, 4, 5], -2);
    io.println(1, "Rotate(-2): " + collections.Join(rotatedLeft, ", "));

    // ============================================================
    // NEW: CREATION & RANGE UTILITIES
    // ============================================================
    io.println(1, "--- Creation & Range ---");

    let empty = collections.Empty();
    io.println(1, "Empty count: " + string(collections.Count(empty)));

    let repeated = collections.Repeat(7, 4);
    io.println(1, "Repeat(7,4): " + collections.Join(repeated, ", "));

    let ranged = collections.Range(0, 5);
    io.println(1, "Range(0,5): " + collections.Join(ranged, ", "));

    let stepped = collections.RangeStep(0, 10, 3);
    io.println(1, "RangeStep(0,10,3): " + collections.Join(stepped, ", "));

    // ============================================================
    // NEW: INDEX OF / LAST INDEX OF
    // ============================================================
    io.println(1, "--- Index Operations ---");

    let items = [10, 20, 30, 20, 50];
    io.println(1, "IndexOf(20): " + string(collections.IndexOf(items, 20)));
    io.println(1, "LastIndexOf(20): " + string(collections.LastIndexOf(items, 20)));
    io.println(1, "IndexOf(99): " + string(collections.IndexOf(items, 99)));

    // ============================================================
    // NEW: ELEMENT AT / SLICE
    // ============================================================
    io.println(1, "--- ElementAt & Slice ---");

    io.println(1, "ElementAt(2): " + string(collections.ElementAt(items, 2)));
    io.println(1, "ElementAt(99): " + string(collections.ElementAt(items, 99)));

    let sliced = collections.Slice(items, 1, 4);
    io.println(1, "Slice(1,4): " + collections.Join(sliced, ", "));

    // ============================================================
    // NEW: STRING SPLIT
    // ============================================================
    io.println(1, "--- String Split ---");

    let parts2 = collections.SplitBy("hello world foo", " ");
    io.println(1, "SplitBy(' '): " + collections.Join(parts2, "|"));

    // ============================================================
    // NEW: SPLITAT
    // ============================================================
    io.println(1, "--- SplitAt ---");
    let splitResult = collections.SplitAt([1, 2, 3, 4, 5], 3);
    io.println(1, "SplitAt(3) returned");

    return 0;
}