attach io;

// Test enums

enum Color {
    Red,
    Green,
    Blue
}

export func main() -> i64 {
    io.println(1, "=== Enum Tests ===");

    let c = Color.Red;
    io.println(1, "Got enum value");

    let val = 42;
    if (val == 42) {
        io.println(1, "forty-two!");
    }

    io.println(1, "=== Enum Tests Passed ===");
    return 0;
}
